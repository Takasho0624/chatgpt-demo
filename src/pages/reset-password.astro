---
import Layout from '../layouts/Layout.astro'
---

<Layout title="けいのBAR パスワード再設定">
  <main class="reset-page">

    <div class="reset-card">

      <div class="reset-title">
        パスワードを再設定
      </div>

      <div class="reset-text">
        新しいパスワードを入力してください
      </div>


      <label
        for="new-password"
        class="field-label"
      >
        新しいパスワード
      </label>

      <input
        id="new-password"
        class="field-input"
        type="password"
        autocomplete="new-password"
        placeholder="6文字以上のパスワード"
      />


      <label
        for="new-password-confirm"
        class="field-label second-label"
      >
        新しいパスワード（確認）
      </label>

      <input
        id="new-password-confirm"
        class="field-input"
        type="password"
        autocomplete="new-password"
        placeholder="もう一度入力してください"
      />


      <button
        id="reset-button"
        class="reset-button"
        type="button"
      >
        新しいパスワードを設定する
      </button>


      <div
        id="reset-message"
        class="reset-message"
      ></div>


      <a
        href="/password"
        class="back-link"
      >
        ← ログイン画面へ戻る
      </a>

    </div>

  </main>
</Layout>


<script>
  import { supabase } from '../utils/supabase'


  /*
   * =========================
   * DOM
   * =========================
   */

  const newPassword =
    document.getElementById(
      'new-password'
    )


  const newPasswordConfirm =
    document.getElementById(
      'new-password-confirm'
    )


  const resetButton =
    document.getElementById(
      'reset-button'
    )


  const resetMessage =
    document.getElementById(
      'reset-message'
    )


  /*
   * =========================
   * メッセージ
   * =========================
   */

  function setMessage(
    text = '',
    type = ''
  ) {

    if (!resetMessage) {
      return
    }


    resetMessage.textContent =
      text


    resetMessage.classList.remove(
      'success',
      'error'
    )


    if (type) {

      resetMessage.classList.add(
        type
      )
    }
  }


  /*
   * =========================
   * パスワード更新
   * =========================
   */

  async function updatePassword() {

    const password =
      newPassword
        ?.value || ''


    const confirmPassword =
      newPasswordConfirm
        ?.value || ''


    if (
      !password ||
      !confirmPassword
    ) {

      setMessage(
        '新しいパスワードを入力してください。',
        'error'
      )

      return
    }


    if (
      password.length < 6
    ) {

      setMessage(
        'パスワードは6文字以上で設定してください。',
        'error'
      )

      return
    }


    if (
      password !==
      confirmPassword
    ) {

      setMessage(
        '確認用のパスワードが一致していません。',
        'error'
      )

      return
    }


    resetButton.disabled =
      true


    resetButton.textContent =
      '設定中…'


    try {

      const {
        data: {
          session,
        },
      } =
        await supabase.auth
          .getSession()


      if (!session) {

        setMessage(
          'パスワード再設定用の認証情報が確認できませんでした。もう一度、再設定メールからアクセスしてください。',
          'error'
        )

        return
      }


      const {
        error,
      } =
        await supabase.auth
          .updateUser({
            password,
          })


      if (error) {

        console.error(
          'Password update error:',
          error
        )


        setMessage(
          'パスワードを変更できませんでした。もう一度お試しください。',
          'error'
        )

        return
      }


      setMessage(
        'パスワードを変更しました🍸 ログイン画面へ移動します。',
        'success'
      )


      /*
       * パスワード変更後はいったんログアウトして、
       * 新しいパスワードで入り直してもらう
       */
      await supabase.auth
        .signOut()


      setTimeout(
        () => {

          window.location.href =
            '/password'
        },
        1800
      )


    } catch (
      error
    ) {

      console.error(
        'Password update exception:',
        error
      )


      setMessage(
        'パスワード変更中にエラーが発生しました。',
        'error'
      )


    } finally {

      resetButton.disabled =
        false


      resetButton.textContent =
        '新しいパスワードを設定する'
    }
  }


  /*
   * =========================
   * ボタン
   * =========================
   */

  resetButton
    ?.addEventListener(
      'click',
      updatePassword
    )


  /*
   * Enterでも実行
   */

  newPasswordConfirm
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key ===
          'Enter'
        ) {

          event.preventDefault()

          updatePassword()
        }
      }
    )
</script>


<style>

.reset-page {

  min-height:
    100vh;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  padding:
    24px;
}


.reset-card {

  width:
    min(
      440px,
      92vw
    );

  padding:
    34px;

  border-radius:
    18px;

  background:
    rgba(
      22,
      13,
      8,
      .80
    );

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      .16
    );

  backdrop-filter:
    blur(12px);

  box-shadow:
    0
    18px
    50px
    rgba(
      0,
      0,
      0,
      .40
    );
}


.reset-title {

  margin-bottom:
    10px;

  color:
    #fff;

  font-size:
    26px;

  font-weight:
    700;

  text-align:
    center;
}


.reset-text {

  margin-bottom:
    24px;

  color:
    rgba(
      255,
      255,
      255,
      .68
    );

  font-size:
    14px;

  line-height:
    1.6;

  text-align:
    center;
}


.field-label {

  display:
    block;

  margin-bottom:
    7px;

  color:
    rgba(
      255,
      255,
      255,
      .72
    );

  font-size:
    13px;
}


.second-label {

  margin-top:
    14px;
}


.field-input {

  width:
    100%;

  height:
    52px;

  box-sizing:
    border-box;

  padding:
    0 14px;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      .20
    );

  border-radius:
    10px;

  outline:
    none;

  background:
    rgba(
      255,
      255,
      255,
      .08
    );

  color:
    #fff;

  font-size:
    16px;
}


.field-input::placeholder {

  color:
    rgba(
      255,
      255,
      255,
      .30
    );
}


.field-input:focus {

  border-color:
    rgba(
      255,
      255,
      255,
      .48
    );

  background:
    rgba(
      255,
      255,
      255,
      .11
    );
}


.reset-button {

  width:
    100%;

  height:
    52px;

  margin-top:
    20px;

  border:
    none;

  border-radius:
    10px;

  background:
    #f5eee9;

  color:
    #25120c;

  font-size:
    15px;

  font-weight:
    700;

  cursor:
    pointer;

  transition:
    transform .15s ease,
    opacity .15s ease;
}


.reset-button:hover {

  transform:
    translateY(-1px);
}


.reset-button:disabled {

  opacity:
    .45;

  cursor:
    default;

  transform:
    none;
}


.reset-message {

  min-height:
    20px;

  margin-top:
    18px;

  color:
    rgba(
      255,
      255,
      255,
      .66
    );

  font-size:
    13px;

  line-height:
    1.7;

  text-align:
    center;
}


.reset-message.success {

  color:
    #b9f6ca;
}


.reset-message.error {

  color:
    #ffb4ab;
}


.back-link {

  display:
    block;

  margin-top:
    18px;

  color:
    rgba(
      255,
      255,
      255,
      .62
    );

  font-size:
    13px;

  text-align:
    center;

  text-decoration:
    underline;
}


.back-link:hover {

  color:
    #fff;
}


@media (
  max-width: 640px
) {

  .reset-page {

    padding:
      16px;
  }


  .reset-card {

    width:
      100%;

    padding:
      28px 20px;
  }


  .reset-title {

    font-size:
      23px;
  }

}

</style>
