---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Generator from '../components/Generator'
import '../message.css'
import 'katex/dist/katex.min.css'
import 'highlight.js/styles/atom-one-dark.css'
---

<Layout title="★けいのBAR">
  <main>

    <div class="login-status">
      <span id="login-name"></span>

      <span class="login-separator">
        ｜
      </span>

      <button
        id="logout-button"
        class="logout-button"
      >
        ログアウト
      </button>
    </div>


    <Header />


    <div class="voice-guide">

      <a
        href="/voice"
        class="voice-link"
      >
        🎙️ けいと声で話す
        <span class="voice-small">
          VOICE版
        </span>
      </a>

    </div>


    <Generator client:load />


    <Footer />

  </main>
</Layout>


<script>
  import { supabase } from '../utils/supabase'

  async function initializeAuth() {

    const {
      data: { user },
    } = await supabase.auth.getUser()


    if (!user) {

      window.location.href =
        '/password'

      return
    }


    const loginName =
      document.getElementById(
        'login-name'
      )


    const googleName =

      user.user_metadata?.full_name ||

      user.user_metadata?.name ||

      user.email?.split('@')[0] ||

      'Googleアカウント'


    if (loginName) {

      loginName.textContent =
        `${googleName}としてログイン中`
    }
  }


  initializeAuth()


  const logoutButton =
    document.getElementById(
      'logout-button'
    )


  logoutButton?.addEventListener(
    'click',
    async () => {

      await supabase.auth.signOut()

      window.location.href =
        '/password'
    }
  )
</script>


<style>

.login-status {

  position: fixed;

  top: 14px;
  right: 18px;

  z-index: 1000;

  display: flex;

  align-items: center;

  gap: 6px;

  padding:
    7px 12px;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      0.22
    );

  border-radius:
    9px;

  background:
    rgba(
      15,
      10,
      7,
      0.50
    );

  backdrop-filter:
    blur(8px);

  color:
    rgba(
      255,
      255,
      255,
      0.82
    );

  font-size:
    12px;

  line-height:
    1;
}


.login-separator {

  color:
    rgba(
      255,
      255,
      255,
      .35
    );
}


.logout-button {

  padding: 0;

  border: none;

  background:
    transparent;

  color:
    rgba(
      255,
      255,
      255,
      .82
    );

  font-size:
    12px;

  cursor:
    pointer;
}


.logout-button:hover {

  color: #fff;

  text-decoration:
    underline;
}



/* =========================
   VOICE版リンク
   ========================= */

.voice-guide {

  display: flex;

  justify-content:
    center;

  margin:
    6px auto 18px;
}


.voice-link {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding:
    10px 16px;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      .20
    );

  border-radius:
    999px;

  background:
    rgba(
      255,
      255,
      255,
      .08
    );

  color: #fff;

  font-size:
    14px;

  text-decoration:
    none;

  backdrop-filter:
    blur(8px);

  transition:
    all .2s ease;
}


.voice-link:hover {

  transform:
    translateY(-1px);

  background:
    rgba(
      255,
      255,
      255,
      .15
    );

  border-color:
    rgba(
      255,
      255,
      255,
      .35
    );
}


.voice-small {

  padding:
    3px 7px;

  border-radius:
    999px;

  background:
    rgba(
      255,
      255,
      255,
      .12
    );

  font-size:
    10px;

  letter-spacing:
    .08em;

  opacity:
    .78;
}



@media (
  max-width: 640px
) {

  .login-status {

    top: 8px;

    right: 8px;

    padding:
      6px 9px;

    font-size:
      10px;
  }


  .logout-button {

    font-size:
      10px;
  }


  .voice-guide {

    margin:
      4px auto 14px;
  }


  .voice-link {

    padding:
      9px 14px;

    font-size:
      13px;
  }

}

</style>
