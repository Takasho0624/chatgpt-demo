                      })
                    )


                    /*
                     * 提供後に
                     * けいから一言
                     */

                    dataChannel.send(
                      JSON.stringify({
                        type:
                          'response.create',

                        response: {
                          instructions: `
カクテルの提供が完了しました。

まず
「${cocktail.name}です。どうぞ」
と自然に伝えてください。

続けて、バーでくつろいでもらうような一言を添えて、
自然に会話へ戻してください。

たとえば
「ゆっくり飲みながらね。今日は何の話しようか？」
「ゆっくりしていってね。今日はどんな話する？」
などです。

ただし毎回同じ例文を使わず、
それまでの会話やお客様の雰囲気に合わせて、
けいらしい自然な言葉で短く問いかけてください。

すでに話していた話題がある場合は、
その話の続きへ自然に戻っても構いません。

カクテルの長い説明は不要です。
                          `.trim(),
                        },
                      })
                    )
                  }

                } catch (error) {

                  console.error(
                    'serve_cocktail error:',
                    error
                  )
                }


                return
              }


              /*
               * =========================
               * Web検索
               * =========================
               */

              if (
                message.type ===
                  'response.function_call_arguments.done' &&
                message.name ===
                  'search_web'
              ) {

                await handleWebSearch(
                  message
                )

                return
              }


              /*
               * =========================
               * response.done
               *
               * 実際の音声終了より
               * 先に来る場合があるので
               * ステータスは変更しない
               * =========================
               */

              if (
                message.type ===
                'response.done'
              ) {

                const usage =
                  message.response?.usage

                console.log(
                  'VOICE USAGE:',
                  usage
                )

                if (usage?.total_tokens) {
                  try {
                    const {
                      data: { session },
                    } =
                      await supabase.auth.getSession()

                    const usageResponse =
                      await fetch(
                        '/api/voice-usage',
                        {
                          method: 'POST',
                          headers: {
                            'Content-Type':
                              'application/json',
                            ...(session?.access_token
                              ? {
                                  Authorization:
                                    `Bearer ${session.access_token}`,
                                }
                              : {}),
                          },
                          body: JSON.stringify({
                            input_tokens:
                              usage.input_tokens || 0,
                            output_tokens:
                              usage.output_tokens || 0,
                            total_tokens:
                              usage.total_tokens || 0,
                          }),
                        }
                      )

                    if (!usageResponse.ok) {
                      console.error(
                        'VOICE TOKEN SAVE FAILED'
                      )
                    }
                  } catch (error) {
                    console.error(
                      'VOICE TOKEN SAVE ERROR:',
                      error
                    )
                  }
                }

                const hasFunctionCall =
                  Array.isArray(
                    message
                      .response
                      ?.output
                  ) &&
                  message
                    .response
                    .output
                    .some(
                      (item) =>
                        item?.type ===
                        'function_call'
                    )


                if (
                  !hasFunctionCall
                ) {

                  setKeiState('')
                }
              }


              /*
               * =========================
               * APIエラー
               * =========================
               */

              if (
                message.type ===
                'error'
              ) {

                console.error(
                  'Realtime API error:',
                  message
                )


                if (
                  status
                ) {

                  status
                    .textContent =
                      '音声APIでエラーが出ました'
                }


                setKeiState('')
              }


            } catch (
              error
            ) {

              console.error(
                'Realtime message error:',
                error
              )
            }
          }


      /*
       * =========================
       * SDP
       * =========================
       */

      const offer =
        await peerConnection
          .createOffer()


      await peerConnection
        .setLocalDescription(
          offer
        )


      const sdpResponse =
        await fetch(
          'https://api.openai.com/v1/realtime/calls',
          {
            method:
              'POST',

            headers: {

              Authorization:
                `Bearer ${ephemeralKey}`,

              'Content-Type':
                'application/sdp',
            },

            body:
              peerConnection
                .localDescription
                .sdp,
          }
        )


      if (
        !sdpResponse.ok
      ) {

        throw new Error(
          await sdpResponse
            .text()
        )
      }


      const answerSdp =
        await sdpResponse
          .text()


      await peerConnection
        .setRemoteDescription({
          type:
            'answer',

          sdp:
            answerSdp,
        })


    } catch (
      error
    ) {

      console.error(
        'Voice start error:',
        error
      )


      if (
        status
      ) {

        status
          .textContent =
            '接続できませんでした'
      }


      setKeiState('')


      stopVoice()
    }
  }


  /*
   * =========================
   * 音声終了
   * =========================
   */

  function stopVoice() {

    stopRealLipSync()

    stopBlinking()


    handledToolCalls
      .clear()


    if (
      dataChannel
    ) {

      dataChannel
        .close()

      dataChannel =
        null
    }


    if (
      peerConnection
    ) {

      peerConnection
        .close()

      peerConnection =
        null
    }


    if (
      localStream
    ) {

      localStream
        .getTracks()
        .forEach(
          (
            track
          ) => {

            track
              .stop()
          }
        )


      localStream =
        null
    }


    if (
      remoteAudio
    ) {

      remoteAudio
        .srcObject =
          null
    }


    if (
      audioContext &&
      audioContext.state !==
        'closed'
    ) {

      audioContext
        .suspend()
    }


    if (
      status
    ) {

      status
        .textContent =
          'マイクを押してね🍸'
    }


    /*
     * 一度会話した後は
     * 「待ってるよ」を戻さない
     */
    if (
      conversationStarted
    ) {

      setKeiState('')

    } else {

      setKeiState(
        '待ってるよ'
      )
    }


    isKeiSpeaking =
      false

    currentMouth =
      ''

    setMouth(
      'close'
    )


    scheduleBlink()


    if (
      voiceButton
    ) {

      voiceButton
        .disabled =
          false
    }


    if (
      stopButton
    ) {

      stopButton
        .disabled =
          true
    }


    /*
     * 次回は新しいVOICEセッション
     */
    currentVoiceSessionId =
      null
  }


  /*
   * =========================
   * イベント
   * =========================
   */

  voiceButton
    ?.addEventListener(
      'click',
      startVoice
    )


  stopButton
    ?.addEventListener(
      'click',
      stopVoice
    )


  logoutButton
    ?.addEventListener(
      'click',
      logout
    )


  window
    .addEventListener(
      'beforeunload',
      () => {

        stopBlinking()
      }
    )


  /*
   * =========================
   * 起動
   * =========================
   */

  preloadAvatarImages()

  initializeUser()
</script>


