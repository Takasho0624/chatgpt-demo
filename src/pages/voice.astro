---
import Layout from '../layouts/Layout.astro'
---

<Layout title="けいのBAR - Voice">
  <main class="voice-page">

    <!-- =========================
         上部ナビ
         ========================= -->

    <div class="voice-topbar">

      <a
        href="/"
        class="back-link"
      >
        ← テキスト版へ戻る
      </a>

      <div class="account-area">

        <span
          id="login-name"
          class="login-name"
        >
          ログイン情報を確認中…
        </span>

        <button
          id="logout-button"
          type="button"
          class="logout-button"
        >
          ログアウト
        </button>

      </div>

    </div>


    <!-- =========================
         メインカード
         ========================= -->

    <section class="bar-card">

      <!-- 名前＋状態 -->

      <div class="voice-meta">

        <span
          id="customer-name"
          class="customer-name"
        >
          お客様
        </span>

        <span
          id="status"
          class="status"
        >
          少し待ってね🍸
        </span>

      </div>


      <!-- =========================
           BARシーン
           ========================= -->

      <div class="kei-area">

        <!-- バックバー -->
        <div class="kei-area__bg"></div>

        <!-- 背景の明暗調整 -->
        <div class="kei-area__overlay"></div>


        <!-- けい -->
        <div class="kei-area__inner">

          <img
            id="kei-avatar"
            src="/kei-mouth-close.png"
            alt="けい"
            class="kei-avatar"
          />

        </div>


        <!-- 前景カウンター -->
        <img
          src="/kei-counter-front.png"
          alt=""
          class="kei-counter-front"
        />


        <!-- 初回待機中だけ表示 -->
        <div
          id="kei-state"
          class="kei-state"
        >
          待ってるよ
        </div>

      </div>


      <!-- =========================
           ボタン
           ========================= -->

      <button
        id="voice-button"
        class="voice-button"
        type="button"
        disabled
      >
        🎙️ けいと話す
      </button>


      <button
        id="stop-button"
        class="stop-button"
        type="button"
        disabled
      >
        会話を終了
      </button>


      <audio
        id="remote-audio"
        autoplay
      ></audio>

    </section>

  </main>
</Layout>


<script>
  import { supabase } from '../utils/supabase'


  /*
   * =========================
   * 基本
   * =========================
   */

  let peerConnection = null
  let localStream = null
  let dataChannel = null

  let displayName = 'お客様'
  let loginDisplayName = ''
  let memory = ''

  /*
   * 一度でも会話開始したか
   */
  let conversationStarted = false


  /*
   * =========================
   * リップシンク
   * =========================
   */

  let audioContext = null
  let analyser = null
  let remoteAudioSource = null
  let lipSyncFrame = null

  let currentMouth = 'close'
  let lastMouthChange = 0
  let silenceFrames = 0


  /*
   * =========================
   * まばたき
   * =========================
   */

  let blinkTimer = null
  let blinkReturnTimer = null

  let isKeiSpeaking = false
  let isBlinking = false


  /*
   * =========================
   * Web検索
   * =========================
   */

  const handledToolCalls =
    new Set()


  /*
   * =========================
   * キャラ画像
   * =========================
   */

  const CLOSED_SRC =
    '/kei-mouth-close.png'

  const SMALL_OPEN_SRC =
    '/kei-mouth-open-small.png'

  const OPEN_SRC =
    '/kei-mouth-open.png'

  const BLINK_SRC =
    '/kei-eyes-close.png'


  /*
   * =========================
   * DOM
   * =========================
   */

  const voiceButton =
    document.getElementById(
      'voice-button'
    )


  const stopButton =
    document.getElementById(
      'stop-button'
    )


  const logoutButton =
    document.getElementById(
      'logout-button'
    )


  const status =
    document.getElementById(
      'status'
    )


  const keiState =
    document.getElementById(
      'kei-state'
    )


  const customerName =
    document.getElementById(
      'customer-name'
    )


  const loginName =
    document.getElementById(
      'login-name'
    )


  const remoteAudio =
    document.getElementById(
      'remote-audio'
    )


  const keiAvatar =
    document.getElementById(
      'kei-avatar'
    )


  /*
   * =========================
   * 画像先読み
   * =========================
   */

  function preloadAvatarImages() {

    [
      CLOSED_SRC,
      SMALL_OPEN_SRC,
      OPEN_SRC,
      BLINK_SRC,
    ].forEach(
      (src) => {

        const image =
          new Image()

        image.src =
          src
      }
    )
  }


  /*
   * =========================
   * 画像内ステータス
   * =========================
   */

  function setKeiState(text = '') {

    if (!keiState) {
      return
    }

    keiState.textContent =
      text
  }


  /*
   * =========================
   * 口
   * =========================
   */

  function setMouth(type) {

    if (!keiAvatar) {
      return
    }


    if (isBlinking) {
      return
    }


    if (
      currentMouth === type
    ) {
      return
    }


    currentMouth =
      type


    if (
      type === 'close'
    ) {

      keiAvatar.src =
        CLOSED_SRC
    }


    if (
      type === 'small'
    ) {

      keiAvatar.src =
        SMALL_OPEN_SRC
    }


    if (
      type === 'open'
    ) {

      keiAvatar.src =
        OPEN_SRC
    }
  }


  /*
   * =========================
   * まばたき
   * =========================
   */

  function scheduleBlink() {

    if (
      blinkTimer
    ) {

      clearTimeout(
        blinkTimer
      )
    }


    /*
     * 約4.5〜8.5秒
     */
    const delay =
      4500 +
      Math.random() *
      4000


    blinkTimer =
      setTimeout(
        () => {

          if (
            !isKeiSpeaking &&
            !isBlinking &&
            keiAvatar
          ) {

            blinkOnce()
          }


          scheduleBlink()

        },
        delay
      )
  }


  function blinkOnce() {

    if (
      !keiAvatar ||
      isKeiSpeaking ||
      isBlinking
    ) {

      return
    }


    isBlinking =
      true


    keiAvatar.src =
      BLINK_SRC


    if (
      blinkReturnTimer
    ) {

      clearTimeout(
        blinkReturnTimer
      )
    }


    blinkReturnTimer =
      setTimeout(
        () => {

          isBlinking =
            false


          if (
            !isKeiSpeaking &&
            keiAvatar
          ) {

            currentMouth =
              'close'

            keiAvatar.src =
              CLOSED_SRC
          }

        },
        140
      )
  }


  function stopBlinking() {

    if (
      blinkTimer
    ) {

      clearTimeout(
        blinkTimer
      )

      blinkTimer =
        null
    }


    if (
      blinkReturnTimer
    ) {

      clearTimeout(
        blinkReturnTimer
      )

      blinkReturnTimer =
        null
    }


    isBlinking =
      false
  }


  /*
   * =========================
   * リップシンク停止
   * =========================
   */

  function stopRealLipSync() {

    if (
      lipSyncFrame
    ) {

      cancelAnimationFrame(
        lipSyncFrame
      )

      lipSyncFrame =
        null
    }


    if (
      remoteAudioSource
    ) {

      try {

        remoteAudioSource
          .disconnect()

      } catch (error) {

        // ignore
      }


      remoteAudioSource =
        null
    }


    analyser =
      null

    silenceFrames =
      0

    isKeiSpeaking =
      false

    currentMouth =
      ''

    setMouth(
      'close'
    )
  }


  /*
   * =========================
   * 実音声リップシンク
   * =========================
   */

  async function startRealLipSync(
    stream
  ) {

    if (!stream) {
      return
    }


    if (
      lipSyncFrame
    ) {

      cancelAnimationFrame(
        lipSyncFrame
      )

      lipSyncFrame =
        null
    }


    if (
      remoteAudioSource
    ) {

      try {

        remoteAudioSource
          .disconnect()

      } catch (error) {

        // ignore
      }


      remoteAudioSource =
        null
    }


    if (
      !audioContext ||
      audioContext.state ===
        'closed'
    ) {

      audioContext =
        new AudioContext()
    }


    if (
      audioContext.state ===
        'suspended'
    ) {

      try {

        await audioContext
          .resume()

      } catch (error) {

        console.warn(
          'AudioContext resume error:',
          error
        )
      }
    }


    analyser =
      audioContext
        .createAnalyser()


    analyser.fftSize =
      512


    analyser
      .smoothingTimeConstant =
        0.70


    remoteAudioSource =
      audioContext
        .createMediaStreamSource(
          stream
        )


    remoteAudioSource
      .connect(
        analyser
      )


    const buffer =
      new Uint8Array(
        analyser.fftSize
      )


    silenceFrames =
      0


    function animate(now) {

      if (!analyser) {
        return
      }


      analyser
        .getByteTimeDomainData(
          buffer
        )


      let sum =
        0


      for (
        let i = 0;
        i < buffer.length;
        i++
      ) {

        const normalized =
          (
            buffer[i] - 128
          ) / 128


        sum +=
          normalized *
          normalized
      }


      const rms =
        Math.sqrt(
          sum /
          buffer.length
        )


      /*
       * =========================
       * 実際にけいの音が
       * 出ているか
       * =========================
       */

      if (
        rms >= 0.010
      ) {

        /*
         * 音が出た瞬間
         */
        isKeiSpeaking =
          true


        silenceFrames =
          0


        /*
         * けいが実際に喋っている間は
         * 「話しかけてね」は絶対出さない
         */
        if (
          conversationStarted &&
          status
        ) {

          status.textContent =
            ''
        }

      } else {

        silenceFrames++


        /*
         * 一瞬の無音ではなく
         * 約12フレーム連続で
         * 静かになったら
         * 実際の音声が終わったと判断
         */
        if (
          silenceFrames > 90
        ) {

          const wasSpeaking =
            isKeiSpeaking


          isKeiSpeaking =
            false


          /*
           * =========================
           * 重要
           *
           * Realtimeのresponse.doneではなく
           * 実際の音声が終わった時だけ
           * 「話しかけてね」に戻す
           * =========================
           */

          if (
            wasSpeaking &&
            conversationStarted &&
            status
          ) {

            status.textContent =
              '話しかけてね🎙️'
          }
        }
      }


      /*
       * =========================
       * 口画像切替
       * =========================
       */

      if (
        now -
        lastMouthChange >
        90
      ) {

        let nextMouth =
          currentMouth


        /*
         * 無音
         */
        if (
          rms < 0.010
        ) {

          if (
            silenceFrames > 5
          ) {

            nextMouth =
              'close'
          }

        } else {

          silenceFrames =
            0

          isKeiSpeaking =
            true


          /*
           * 小さい声
           */
          if (
            rms < 0.028
          ) {

            nextMouth =
              'small'


          /*
           * 普通
           */
          } else if (
            rms < 0.060
          ) {

            nextMouth =
              Math.random() <
              0.78
                ? 'small'
                : 'open'


          /*
           * 大きめ
           */
          } else {

            nextMouth =
              Math.random() <
              0.55
                ? 'small'
                : 'open'
          }
        }


        if (
          nextMouth !==
          currentMouth
        ) {

          setMouth(
            nextMouth
          )

          lastMouthChange =
            now
        }
      }


      lipSyncFrame =
        requestAnimationFrame(
          animate
        )
    }


    lipSyncFrame =
      requestAnimationFrame(
        animate
      )
  }


  /*
   * =========================
   * ユーザー初期化
   * =========================
   */

  async function initializeUser() {

    try {

      const {
        data: { user },
      } =
        await supabase
          .auth
          .getUser()


      /*
       * 未ログイン
       */
      if (!user) {

        window.location.href =
          '/password'

        return
      }


      /*
       * Googleログイン名
       */
      loginDisplayName =
        user
          .user_metadata
          ?.full_name ||

        user
          .user_metadata
          ?.name ||

        user
          .email ||

        'ログイン中'


      /*
       * BARプロフィール
       */
      const {
        data: profile,
        error,
      } =
        await supabase
          .from('profiles')
          .select(
            'display_name, memory, name_confirmed'
          )
          .eq(
            'user_id',
            user.id
          )
          .maybeSingle()


      if (error) {

        console.error(
          'Profile error:',
          error
        )
      }


      /*
       * けいが呼ぶ名前
       */
      if (
        profile?.display_name &&
        profile
          .display_name
          .trim()
      ) {

        displayName =
          profile
            .display_name
            .trim()

      } else {

        displayName =
          user
            .user_metadata
            ?.full_name ||

          user
            .user_metadata
            ?.name ||

          user
            .email
            ?.split('@')[0] ||

          'お客様'
      }


      /*
       * 記憶
       */
      if (
        profile?.memory
      ) {

        memory =
          profile.memory
      }


      /*
       * 画面
       */
      if (
        customerName
      ) {

        customerName
          .textContent =
            displayName
      }


      if (
        loginName
      ) {

        loginName
          .textContent =
            `${loginDisplayName}としてログイン中`
      }


      if (
        status
      ) {

        status
          .textContent =
            'マイクを押してね🍸'
      }


      /*
       * 初回だけ
       */
      conversationStarted =
        false


      setKeiState(
        '待ってるよ'
      )


      currentMouth =
        ''

      setMouth(
        'close'
      )


      scheduleBlink()


      if (
        voiceButton
      ) {

        voiceButton
          .disabled =
            false
      }


    } catch (
      error
    ) {

      console.error(
        'Initialize error:',
        error
      )


      if (
        status
      ) {

        status
          .textContent =
            'ユーザー情報を取得できませんでした'
      }
    }
  }


  /*
   * =========================
   * ログアウト
   * =========================
   */

  async function logout() {

    try {

      stopVoice()


      await supabase
        .auth
        .signOut()


      window.location.href =
        '/'

    } catch (
      error
    ) {

      console.error(
        'Logout error:',
        error
      )
    }
  }


  /*
   * =========================
   * Web検索
   * =========================
   */

  async function handleWebSearch(
    message
  ) {

    if (
      !dataChannel ||
      dataChannel.readyState !==
        'open'
    ) {

      return
    }


    const callId =
      message.call_id


    if (!callId) {

      console.error(
        'search_web: call_id がありません',
        message
      )

      return
    }


    if (
      handledToolCalls
        .has(callId)
    ) {

      return
    }


    handledToolCalls
      .add(callId)


    let args = {}


    try {

      args =
        JSON.parse(
          message.arguments ||
          '{}'
        )

    } catch (error) {

      console.error(
        'Tool arguments parse error:',
        error
      )
    }


    const query =
      typeof args.query ===
        'string'
        ? args.query.trim()
        : ''


    /*
     * 検索語なし
     */
    if (!query) {

      dataChannel.send(
        JSON.stringify({
          type:
            'conversation.item.create',

          item: {
            type:
              'function_call_output',

            call_id:
              callId,

            output:
              '検索キーワードが取得できませんでした。',
          },
        })
      )


      dataChannel.send(
        JSON.stringify({
          type:
            'response.create',
        })
      )


      return
    }


    /*
     * 上の状態だけ表示
     */
    if (
      status
    ) {

      status.textContent =
        '調べてるよ…🌐'
    }


    setKeiState('')


    try {

      const response =
        await fetch(
          '/api/web-search',
          {
            method:
              'POST',

            headers: {
              'Content-Type':
                'application/json',
            },

            body:
              JSON.stringify({
                query,
              }),
          }
        )


      const result =
        await response
          .json()


      let answer =
        ''


      if (
        response.ok &&
        typeof result.answer ===
          'string'
      ) {

        answer =
          result.answer.trim()

      } else {

        answer =
          'Web検索を試しましたが、今回は情報を取得できませんでした。'
      }


      dataChannel.send(
        JSON.stringify({
          type:
            'conversation.item.create',

          item: {
            type:
              'function_call_output',

            call_id:
              callId,

            output:
              answer,
          },
        })
      )


      dataChannel.send(
        JSON.stringify({
          type:
            'response.create',

          response: {
            instructions: `
search_web の検索結果が返ってきました。

検索結果を踏まえて、
お客様の元の質問に答えてください。

検索結果をそのまま読み上げるのではなく、
内容を理解したうえで、
けい自身の自然な会話として説明してください。

なるべく短く答えてください。

URLは読み上げないでください。

検索結果に不確かな点がある場合は、
断定しないでください。
            `.trim(),
          },
        })
      )


      if (
        status
      ) {

        status.textContent =
          'ちょっと待ってね…'
      }


    } catch (
      error
    ) {

      console.error(
        'Web search error:',
        error
      )


      dataChannel.send(
        JSON.stringify({
          type:
            'conversation.item.create',

          item: {
            type:
              'function_call_output',

            call_id:
              callId,

            output:
              'Web検索中にエラーが発生し、最新情報を取得できませんでした。',
          },
        })
      )


      dataChannel.send(
        JSON.stringify({
          type:
            'response.create',

          response: {
            instructions: `
Web検索がうまくいきませんでした。

知っているふりをせず、
自然な会話として短く伝えてください。
            `.trim(),
          },
        })
      )
    }
  }


  /*
   * =========================
   * 音声開始
   * =========================
   */

  async function startVoice() {

    try {

      /*
       * 会話開始。
       * 「待ってるよ」はここで消す。
       */
      conversationStarted =
        true


      setKeiState('')


      handledToolCalls
        .clear()


      if (
        voiceButton
      ) {

        voiceButton
          .disabled =
            true
      }


      if (
        status
      ) {

        status
          .textContent =
            'つないでるよ…'
      }


      currentMouth =
        ''

      setMouth(
        'close'
      )


      /*
       * Realtime token
       */
      const tokenResponse =
        await fetch(
          '/api/realtime',
          {
            method:
              'POST',

            headers: {
              'Content-Type':
                'application/json',
            },

            body:
              JSON.stringify({
                displayName,
                memory,
              }),
          }
        )


      if (
        !tokenResponse.ok
      ) {

        throw new Error(
          await tokenResponse
            .text()
        )
      }


      const tokenData =
        await tokenResponse
          .json()


      const ephemeralKey =
        tokenData.value ||

        tokenData
          .client_secret
          ?.value ||

        tokenData
          .client_secret


      if (
        !ephemeralKey
      ) {

        console.error(
          tokenData
        )

        throw new Error(
          'Realtime token が取得できませんでした'
        )
      }


      /*
       * WebRTC
       */
      peerConnection =
        new RTCPeerConnection()


      /*
       * けいの音声
       */
      if (
        remoteAudio
      ) {

        remoteAudio
          .autoplay =
            true


        peerConnection
          .ontrack =
            async (
              event
            ) => {

              const remoteStream =
                event
                  .streams[0]


              remoteAudio
                .srcObject =
                  remoteStream


              try {

                await remoteAudio
                  .play()

              } catch (
                error
              ) {

                console.warn(
                  'Audio play error:',
                  error
                )
              }


              /*
               * 実音声で
               * リップシンク
               */
              await startRealLipSync(
                remoteStream
              )
            }
      }


      /*
       * お客様マイク
       */
      localStream =
        await navigator
          .mediaDevices
          .getUserMedia({
            audio: {

              echoCancellation:
                true,

              noiseSuppression:
                true,

              autoGainControl:
                true,
            },
          })


      localStream
        .getTracks()
        .forEach(
          (
            track
          ) => {

            peerConnection
              .addTrack(
                track,
                localStream
              )
          }
        )


      /*
       * DataChannel
       */
      dataChannel =
        peerConnection
          .createDataChannel(
            'oai-events'
          )


      dataChannel
        .onopen =
          () => {

            /*
             * 会話開始後は
             * 画像内表示なし
             */
            setKeiState('')


            if (
              status
            ) {

              status
                .textContent =
                  'つながったよ🎙️'
            }


            if (
              stopButton
            ) {

              stopButton
                .disabled =
                  false
            }


            /*
             * 最初の挨拶
             */
            dataChannel
              .send(
                JSON.stringify({
                  type:
                    'response.create',

                  response: {

                    instructions: `
お客様が来店しました。

自然に
「いらっしゃいませ」
と挨拶してください。

お客様の呼び名は
「${displayName}」
です。

すでに知っているお客様を迎えるような、
親しみのある短い挨拶にしてください。

必要なら
「ゆっくりしていってね」
と言ってください。

「ゆっくり見ていってね」
とは言わないでください。

挨拶は長くしないでください。
                    `.trim(),
                  },
                })
              )
          }


      /*
       * =========================
       * Realtimeイベント
       * =========================
       */

      dataChannel
        .onmessage =
          async (
            event
          ) => {

            try {

              const message =
                JSON.parse(
                  event.data
                )


              /*
               * お客様が話し始めた
               */
              if (
                message.type ===
                'input_audio_buffer.speech_started'
              ) {

                if (
                  status
                ) {

                  status
                    .textContent =
                      'うんうん…'
                }


                setKeiState('')
              }


              /*
               * お客様が話し終わった
               */
              if (
                message.type ===
                'input_audio_buffer.speech_stopped'
              ) {

                if (
                  status
                ) {

                  status
                    .textContent =
                      'ちょっと考えてる…'
                }


                setKeiState('')
              }


              /*
               * けいが話している
               */
              if (
                message.type ===
                  'response.audio.delta' ||

                message.type ===
                  'response.output_audio.delta'
              ) {

                isKeiSpeaking =
                  true


                /*
                 * けいが喋っている最中は
                 * ステータス文字を消す
                 */
                if (
                  status
                ) {

                  status
                    .textContent =
                      ''
                }


                setKeiState('')
              }


              /*
               * Web検索
               */
              if (
                message.type ===
                  'response.function_call_arguments.done' &&
                message.name ===
                  'search_web'
              ) {

                await handleWebSearch(
                  message
                )

                return
              }


              /*
               * =========================
               * response.done
               * =========================
               *
               * 重要：
               *
               * response.done は
               * 実際の音声再生が終わるより
               * 先に来る場合がある。
               *
               * だからここでは
               * 「話しかけてね」に戻さない。
               *
               * 実際の音声波形が
               * 無音になった時に戻す。
               */

              if (
                message.type ===
                'response.done'
              ) {

                const hasFunctionCall =
                  Array.isArray(
                    message
                      .response
                      ?.output
                  ) &&
                  message
                    .response
                    .output
                    .some(
                      (item) =>
                        item?.type ===
                        'function_call'
                    )


                if (
                  !hasFunctionCall
                ) {

                  setKeiState('')
                }
              }


              /*
               * APIエラー
               */
              if (
                message.type ===
                'error'
              ) {

                console.error(
                  'Realtime API error:',
                  message
                )


                if (
                  status
                ) {

                  status
                    .textContent =
                      '音声APIでエラーが出ました'
                }


                setKeiState('')
              }


            } catch (
              error
            ) {

              console.error(
                'Realtime message error:',
                error
              )
            }
          }


      /*
       * =========================
       * SDP
       * =========================
       */

      const offer =
        await peerConnection
          .createOffer()


      await peerConnection
        .setLocalDescription(
          offer
        )


      const sdpResponse =
        await fetch(
          'https://api.openai.com/v1/realtime/calls',
          {
            method:
              'POST',

            headers: {

              Authorization:
                `Bearer ${ephemeralKey}`,

              'Content-Type':
                'application/sdp',
            },

            body:
              peerConnection
                .localDescription
                .sdp,
          }
        )


      if (
        !sdpResponse.ok
      ) {

        throw new Error(
          await sdpResponse
            .text()
        )
      }


      const answerSdp =
        await sdpResponse
          .text()


      await peerConnection
        .setRemoteDescription({
          type:
            'answer',

          sdp:
            answerSdp,
        })


    } catch (
      error
    ) {

      console.error(
        'Voice start error:',
        error
      )


      if (
        status
      ) {

        status
          .textContent =
            '接続できませんでした'
      }


      setKeiState('')


      stopVoice()
    }
  }


  /*
   * =========================
   * 音声終了
   * =========================
   */

  function stopVoice() {

    stopRealLipSync()

    stopBlinking()


    handledToolCalls
      .clear()


    if (
      dataChannel
    ) {

      dataChannel
        .close()

      dataChannel =
        null
    }


    if (
      peerConnection
    ) {

      peerConnection
        .close()

      peerConnection =
        null
    }


    if (
      localStream
    ) {

      localStream
        .getTracks()
        .forEach(
          (
            track
          ) => {

            track
              .stop()
          }
        )


      localStream =
        null
    }


    if (
      remoteAudio
    ) {

      remoteAudio
        .srcObject =
          null
    }


    if (
      audioContext &&
      audioContext.state !==
        'closed'
    ) {

      audioContext
        .suspend()
    }


    if (
      status
    ) {

      status
        .textContent =
          'マイクを押してね🍸'
    }


    /*
     * 一度会話した後は
     * 待ってるよを戻さない
     */
    if (
      conversationStarted
    ) {

      setKeiState('')

    } else {

      setKeiState(
        '待ってるよ'
      )
    }


    isKeiSpeaking =
      false

    currentMouth =
      ''

    setMouth(
      'close'
    )


    scheduleBlink()


    if (
      voiceButton
    ) {

      voiceButton
        .disabled =
          false
    }


    if (
      stopButton
    ) {

      stopButton
        .disabled =
          true
    }
  }


  /*
   * =========================
   * イベント
   * =========================
   */

  voiceButton
    ?.addEventListener(
      'click',
      startVoice
    )


  stopButton
    ?.addEventListener(
      'click',
      stopVoice
    )


  logoutButton
    ?.addEventListener(
      'click',
      logout
    )


  window
    .addEventListener(
      'beforeunload',
      () => {

        stopBlinking()
      }
    )


  /*
   * =========================
   * 起動
   * =========================
   */

  preloadAvatarImages()

  initializeUser()
</script>


