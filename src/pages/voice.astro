---
import Layout from '../layouts/Layout.astro'
---

<Layout title="けいのBAR - Voice">
  <main class="voice-page">

    <!-- =========================
         上部ナビ
         ========================= -->

    <div class="voice-topbar">

      <a
        href="/"
        class="back-link"
      >
        ← テキスト版へ戻る
      </a>

      <div class="account-area">

        <span
          id="login-name"
          class="login-name"
        >
          ログイン情報を確認中…
        </span>

        <button
          id="logout-button"
          type="button"
          class="logout-button"
        >
          ログアウト
        </button>

      </div>

    </div>


    <!-- =========================
         メインカード
         ========================= -->

    <section class="bar-card">

      <!-- 名前＋状態 -->

      <div class="voice-meta">

        <span
          id="customer-name"
          class="customer-name"
        >
          お客様
        </span>

        <span
          id="status"
          class="status"
        >
          少し待ってね🍸
        </span>

      </div>


      <!-- =========================
           BARシーン
           ========================= -->

      <div class="kei-area">

        <!-- バックバー -->
        <div class="kei-area__bg"></div>

        <!-- 背景の明暗調整 -->
        <div class="kei-area__overlay"></div>


        <!-- けい -->
        <div class="kei-area__inner">

          <img
            id="kei-avatar"
            src="/kei-mouth-close.png"
            alt="けい"
            class="kei-avatar"
          />

        </div>


        <!-- 前景カウンター -->
        <img
          src="/kei-counter-front.png"
          alt=""
          class="kei-counter-front"
        />


        
        <!-- =========================
             カクテルメニュー
             ========================= -->
        <div
          id="cocktail-menu"
          class="cocktail-menu"
          hidden
        >
          <img
            src="/cocktails/cocktail-menu.png"
            alt="スタンダードカクテルメニュー"
            class="cocktail-menu__image"
          />

          <button
            id="cocktail-menu-close"
            class="cocktail-menu__close"
            type="button"
            aria-label="メニューを閉じる"
          >
            ×
          </button>
        </div>

        <!-- =========================
             提供されたカクテル
             ========================= -->
        <img
          id="served-cocktail"
          class="served-cocktail"
          src=""
          alt=""
          hidden
        />

        <!-- 初回待機中だけ表示 -->
        <div
          id="kei-state"
          class="kei-state"
        >
          待ってるよ
        </div>

      </div>


      <!-- =========================
           ボタン
           ========================= -->

      <button
        id="voice-button"
        class="voice-button"
        type="button"
        disabled
      >
        🎙️ けいと話す
      </button>


      <button
        id="stop-button"
        class="stop-button"
        type="button"
        disabled
      >
        会話を終了
      </button>


      <audio
        id="remote-audio"
        autoplay
      ></audio>

    </section>

  
    <!-- VOICE試用モード切替 -->
    <button
      id="trial-mode-button"
      type="button"
      class="trial-mode-button"
    >
      試用モード：ON（10分）
    </button>

</main>
</Layout>


<script>
  import { supabase } from '../utils/supabase'


  /*
   * =========================
   * 基本
   * =========================
   */

  let peerConnection = null
  let localStream = null
  let dataChannel = null

  let displayName = 'お客様'
  let loginDisplayName = ''
  let memory = ''


  /*
   * =========================
   * 呼び名の敬称処理
   *
   * 敬称が付いていない場合だけ
   * 「さん」を付ける
   * =========================
   */

  function addHonorific(name) {

    const trimmedName =
      typeof name === 'string'
        ? name.trim()
        : ''


    if (!trimmedName) {
      return 'お客様'
    }


    /*
     * 「お客様」はそのまま
     */
    if (
      trimmedName === 'お客様'
    ) {

      return trimmedName
    }


    /*
     * すでに敬称が付いている場合は
     * そのまま使用
     */
    const hasHonorific =
      /(?:さん|くん|君|ちゃん|先生|さま|様|氏)$/
        .test(
          trimmedName
        )


    if (hasHonorific) {

      return trimmedName
    }


    /*
     * 敬称がない場合だけ
     * 「さん」を付ける
     */
    return `${trimmedName}さん`
  }

  /*
   * ログイン中ユーザー
   */
  let currentUserId = null

  /*
   * 1回のVOICE接続ごとのID
   */
  let currentVoiceSessionId = null

  /*
   * 同じ文字起こしイベントを
   * 二重保存しないため
   */
  const savedTranscriptKeys =
    new Set()


  /*
   * 一度でも会話開始したか
   */
  let conversationStarted = false


  /*
   * =========================
   * リップシンク
   * =========================
   */

  let audioContext = null
  let analyser = null
  let remoteAudioSource = null
  let lipSyncFrame = null

  let currentMouth = 'close'
  let lastMouthChange = 0
  let silenceFrames = 0


  /*
   * =========================
   * まばたき
   * =========================
   */

  let blinkTimer = null
  let blinkReturnTimer = null

  let isKeiSpeaking = false
  let isBlinking = false


  /*
   * =========================
   * Web検索
   * =========================
   */

  const handledToolCalls =
    new Set()


  /*
   * =========================
   * キャラ画像
   * =========================
   */

  const CLOSED_SRC =
    '/kei-mouth-close.png'

  const SMALL_OPEN_SRC =
    '/kei-mouth-open-small.png'

  const OPEN_SRC =
    '/kei-mouth-open.png'

  const BLINK_SRC =
    '/kei-eyes-close.png'


  /*
   * =========================
   * DOM
   * =========================
   */

  const voiceButton =
    document.getElementById(
      'voice-button'
    )


  const stopButton =
    document.getElementById(
      'stop-button'
    )


  const logoutButton =
    document.getElementById(
      'logout-button'
    )


  const status =
    document.getElementById(
      'status'
    )


  const keiState =
    document.getElementById(
      'kei-state'
    )


  const customerName =
    document.getElementById(
      'customer-name'
    )


  const loginName =
    document.getElementById(
      'login-name'
    )


  const remoteAudio =
    document.getElementById(
      'remote-audio'
    )


  const keiAvatar =
    document.getElementById(
      'kei-avatar'
    )



  /*
   * =========================
   * カクテルメニュー
   * =========================
   */

  const cocktailMenu =
    document.getElementById(
      'cocktail-menu'
    )

  const cocktailMenuClose =
    document.getElementById(
      'cocktail-menu-close'
    )

  const servedCocktail =
    document.getElementById(
      'served-cocktail'
    )

  const cocktails = {
    1: {
      name: 'マティーニ',
      src: '/cocktails/1_martini.png',
    },

    2: {
      name: 'マンハッタン',
      src: '/cocktails/2_manhattan.png',
    },

    3: {
      name: 'ギムレット',
      src: '/cocktails/3_gimlet.png',
    },

    4: {
      name: 'ダイキリ',
      src: '/cocktails/4_daiquiri.png',
    },

    5: {
      name: 'サイドカー',
      src: '/cocktails/5_sidecar.png',
    },

    6: {
      name: 'ホワイトレディ',
      src: '/cocktails/6_white-lady.png',
    },

    7: {
      name: 'ネグローニ',
      src: '/cocktails/7_negroni.png',
    },

    8: {
      name: 'オールドファッションド',
      src: '/cocktails/8_old-fashioned.png',
    },

    9: {
      name: 'ジントニック',
      src: '/cocktails/9_gin-tonic.png',
    },

    10: {
      name: 'モスコミュール',
      src: '/cocktails/10_moscow-mule.png',
    },

    11: {
      name: 'カシスオレンジ',
      src: '/cocktails/11_cassis-orange.png',
    },

    12: {
      name: 'ファジーネーブル',
      src: '/cocktails/12_fuzzy-navel.png',
    },
  }


  function showCocktailMenu() {

    if (!cocktailMenu) {
      return
    }

    cocktailMenu.hidden =
      false

    if (keiAvatar) {
      keiAvatar.classList.add('kei-avatar--menu-open')
    }
  }


  function hideCocktailMenu() {

    if (!cocktailMenu) {
      return
    }

    cocktailMenu.hidden =
      true

    if (keiAvatar) {
      keiAvatar.classList.remove('kei-avatar--menu-open')
    }

    if (keiAvatar) {
      keiAvatar.style.left =
        '50%'

      keiAvatar.style.maxWidth =
        '86%'
    }
  }


  function serveCocktail(
    number
  ) {

    const cocktail =
      cocktails[number]

    if (
      !cocktail ||
      !servedCocktail
    ) {

      return null
    }


    hideCocktailMenu()


    servedCocktail.src =
      cocktail.src

    servedCocktail.alt =
      cocktail.name

    servedCocktail.hidden =
      false


    return cocktail
  }


  cocktailMenuClose
    ?.addEventListener(
      'click',
      hideCocktailMenu
    )


  /*
   * =========================
   * 現在の日本時間
   * =========================
   */

  function getJapanTimeInfo() {

    const now =
      new Date()


    const dateTimeText =
      new Intl.DateTimeFormat(
        'ja-JP',
        {
          timeZone:
            'Asia/Tokyo',

          year:
            'numeric',

          month:
            'long',

          day:
            'numeric',

          weekday:
            'short',

          hour:
            '2-digit',

          minute:
            '2-digit',

          hourCycle:
            'h23',
        }
      ).format(now)


    const hourParts =
      new Intl.DateTimeFormat(
        'ja-JP',
        {
          timeZone:
            'Asia/Tokyo',

          hour:
            'numeric',

          hourCycle:
            'h23',
        }
      ).formatToParts(now)


    const hour =
      Number(
        hourParts.find(
          part =>
            part.type ===
            'hour'
        )?.value || '0'
      )


    return {
      text:
        dateTimeText,

      hour,
    }
  }


  /*
   * =========================
   * VOICEセッションID生成
   * =========================
   */

  function createVoiceSessionId() {

    const randomPart =
      Math.random()
        .toString(36)
        .slice(2, 10)


    return (
      `voice_${Date.now()}_${randomPart}`
    )
  }


  /*
   * =========================
   * VOICE全文ログ保存
   * =========================
   */

  async function saveVoiceMessage(
    role,
    content,
    uniqueKey = ''
  ) {

    const cleanContent =
      typeof content === 'string'
        ? content.trim()
        : ''


    if (
      !cleanContent ||
      !currentUserId ||
      !currentVoiceSessionId
    ) {

      return
    }


    /*
     * 二重保存防止
     */
    if (
      uniqueKey &&
      savedTranscriptKeys
        .has(uniqueKey)
    ) {

      return
    }


    if (uniqueKey) {

      savedTranscriptKeys
        .add(uniqueKey)
    }


    try {

      const { error } =
        await supabase
          .from(
            'voice_messages'
          )
          .insert({
            user_id:
              currentUserId,

            session_id:
              currentVoiceSessionId,

            role,

            content:
              cleanContent,
          })


      if (error) {

        console.error(
          'Voice log save error:',
          error
        )


        if (uniqueKey) {

          savedTranscriptKeys
            .delete(uniqueKey)
        }


        return
      }


      console.log(
        'Voice log saved:',
        role,
        cleanContent
      )


    } catch (
      error
    ) {

      console.error(
        'Voice log save exception:',
        error
      )


      if (uniqueKey) {

        savedTranscriptKeys
          .delete(uniqueKey)
      }
    }
  }


  /*
   * =========================
   * 画像先読み
   * =========================
   */

  function preloadAvatarImages() {

    [
      CLOSED_SRC,
      SMALL_OPEN_SRC,
      OPEN_SRC,
      BLINK_SRC,
    ].forEach(
      (src) => {

        const image =
          new Image()

        image.src =
          src
      }
    )
  }


  /*
   * =========================
   * 画像内ステータス
   * =========================
   */

  function setKeiState(text = '') {

    if (!keiState) {
      return
    }

    keiState.textContent =
      text
  }


  /*
   * =========================
   * 口
   * =========================
   */

  function setMouth(type) {

    if (!keiAvatar) {
      return
    }


    if (isBlinking) {
      return
    }


    if (
      currentMouth === type
    ) {
      return
    }


    currentMouth =
      type


    if (
      type === 'close'
    ) {

      keiAvatar.src =
        CLOSED_SRC
    }


    if (
      type === 'small'
    ) {

      keiAvatar.src =
        SMALL_OPEN_SRC
    }


    if (
      type === 'open'
    ) {

      keiAvatar.src =
        OPEN_SRC
    }
  }


  /*
   * =========================
   * まばたき
   * =========================
   */

  function scheduleBlink() {

    if (
      blinkTimer
    ) {

      clearTimeout(
        blinkTimer
      )
    }


    /*
     * 約4.5〜8.5秒
     */
    const delay =
      4500 +
      Math.random() *
      4000


    blinkTimer =
      setTimeout(
        () => {

          if (
            !isKeiSpeaking &&
            !isBlinking &&
            keiAvatar
          ) {

            blinkOnce()
          }


          scheduleBlink()

        },
        delay
      )
  }


  function blinkOnce() {

    if (
      !keiAvatar ||
      isKeiSpeaking ||
      isBlinking
    ) {

      return
    }


    isBlinking =
      true


    keiAvatar.src =
      BLINK_SRC


    if (
      blinkReturnTimer
    ) {

      clearTimeout(
        blinkReturnTimer
      )
    }


    blinkReturnTimer =
      setTimeout(
        () => {

          isBlinking =
            false


          if (
            !isKeiSpeaking &&
            keiAvatar
          ) {

            currentMouth =
              'close'

            keiAvatar.src =
              CLOSED_SRC
          }

        },
        140
      )
  }


  function stopBlinking() {

    if (
      blinkTimer
    ) {

      clearTimeout(
        blinkTimer
      )

      blinkTimer =
        null
    }


    if (
      blinkReturnTimer
    ) {

      clearTimeout(
        blinkReturnTimer
      )

      blinkReturnTimer =
        null
    }


    isBlinking =
      false
  }


  /*
   * =========================
   * リップシンク停止
   * =========================
   */

  function stopRealLipSync() {

    if (
      lipSyncFrame
    ) {

      cancelAnimationFrame(
        lipSyncFrame
      )

      lipSyncFrame =
        null
    }


    if (
      remoteAudioSource
    ) {

      try {

        remoteAudioSource
          .disconnect()

      } catch (error) {

        // ignore
      }


      remoteAudioSource =
        null
    }


    analyser =
      null

    silenceFrames =
      0

    isKeiSpeaking =
      false

    currentMouth =
      ''

    setMouth(
      'close'
    )
  }


  /*
   * =========================
   * 実音声リップシンク
   * =========================
   */

  async function startRealLipSync(
    stream
  ) {

    if (!stream) {
      return
    }


    if (
      lipSyncFrame
    ) {

      cancelAnimationFrame(
        lipSyncFrame
      )

      lipSyncFrame =
        null
    }


    if (
      remoteAudioSource
    ) {

      try {

        remoteAudioSource
          .disconnect()

      } catch (error) {

        // ignore
      }


      remoteAudioSource =
        null
    }


    if (
      !audioContext ||
      audioContext.state ===
        'closed'
    ) {

      audioContext =
        new AudioContext()
    }


    if (
      audioContext.state ===
        'suspended'
    ) {

      try {

        await audioContext
          .resume()

      } catch (error) {

        console.warn(
          'AudioContext resume error:',
          error
        )
      }
    }


    analyser =
      audioContext
        .createAnalyser()


    analyser.fftSize =
      512


    analyser
      .smoothingTimeConstant =
        0.70


    remoteAudioSource =
      audioContext
        .createMediaStreamSource(
          stream
        )


    remoteAudioSource
      .connect(
        analyser
      )


    const buffer =
      new Uint8Array(
        analyser.fftSize
      )


    silenceFrames =
      0


    function animate(now) {

      if (!analyser) {
        return
      }


      analyser
        .getByteTimeDomainData(
          buffer
        )


      let sum =
        0


      for (
        let i = 0;
        i < buffer.length;
        i++
      ) {

        const normalized =
          (
            buffer[i] - 128
          ) / 128


        sum +=
          normalized *
          normalized
      }


      const rms =
        Math.sqrt(
          sum /
          buffer.length
        )


      /*
       * =========================
       * 実際にけいの音が
       * 出ているか
       * =========================
       */

      if (
        rms >= 0.010
      ) {

        isKeiSpeaking =
          true


        silenceFrames =
          0


        /*
         * けいが喋っている間は
         * 上の状態文字を消す
         */
        if (
          conversationStarted &&
          status
        ) {

          status.textContent =
            ''
        }

      } else {

        silenceFrames++


        /*
         * 約1.5秒程度
         * 無音が続いてから終了判定
         */
        if (
          silenceFrames > 90
        ) {

          const wasSpeaking =
            isKeiSpeaking


          isKeiSpeaking =
            false


          /*
           * response.doneではなく
           * 実際の音声終了時に戻す
           */
          if (
            wasSpeaking &&
            conversationStarted &&
            status
          ) {

            status.textContent =
              '話しかけてね🎙️'
          }
        }
      }


      /*
       * =========================
       * 口画像切替
       * =========================
       */

      if (
        now -
        lastMouthChange >
        90
      ) {

        let nextMouth =
          currentMouth


        /*
         * 無音
         */
        if (
          rms < 0.010
        ) {

          if (
            silenceFrames > 5
          ) {

            nextMouth =
              'close'
          }

        } else {

          silenceFrames =
            0

          isKeiSpeaking =
            true


          /*
           * 小さい声
           */
          if (
            rms < 0.028
          ) {

            nextMouth =
              'small'


          /*
           * 普通
           */
          } else if (
            rms < 0.060
          ) {

            nextMouth =
              Math.random() <
              0.78
                ? 'small'
                : 'open'


          /*
           * 大きめ
           */
          } else {

            nextMouth =
              Math.random() <
              0.55
                ? 'small'
                : 'open'
          }
        }


        if (
          nextMouth !==
          currentMouth
        ) {

          setMouth(
            nextMouth
          )

          lastMouthChange =
            now
        }
      }


      lipSyncFrame =
        requestAnimationFrame(
          animate
        )
    }


    lipSyncFrame =
      requestAnimationFrame(
        animate
      )
  }


  /*
   * =========================
   * ユーザー初期化
   * =========================
   */

  async function initializeUser() {

    try {

      const {
        data: { user },
      } =
        await supabase
          .auth
          .getUser()


      /*
       * 未ログイン
       */
      if (!user) {

        window.location.href =
          '/password'

        return
      }


      /*
       * ログ保存用
       */
      currentUserId =
        user.id


      /*
       * Googleログイン名
       */
      loginDisplayName =
        user
          .user_metadata
          ?.full_name ||

        user
          .user_metadata
          ?.name ||

        user
          .email ||

        'ログイン中'


      /*
       * BARプロフィール
       */
      const {
        data: profile,
        error,
      } =
        await supabase
          .from('profiles')
          .select(
            'display_name, memory, name_confirmed'
          )
          .eq(
            'user_id',
            user.id
          )
          .maybeSingle()


      if (error) {

        console.error(
          'Profile error:',
          error
        )
      }


      /*
       * =========================
       * けいが呼ぶ名前
       * =========================
       *
       * profiles.display_name を最優先。
       *
       * 「中村」のように敬称なしで
       * 登録されている場合は
       * 「中村さん」にする。
       *
       * 「ショウくん」
       * 「けいちゃん」
       * 「山田先生」
       * など、すでに敬称がある場合は
       * そのまま使う。
       */

      if (
        profile?.display_name &&
        profile
          .display_name
          .trim()
      ) {

        displayName =
          addHonorific(
            profile
              .display_name
              .trim()
          )

      } else {

        /*
         * profileがまだ無い場合は
         * Auth metadataから取得。
         *
         * メール登録時に保存している
         * display_name / nickname も
         * ここで拾う。
         */
        const fallbackName =
          user
            .user_metadata
            ?.display_name ||

          user
            .user_metadata
            ?.nickname ||

          user
            .user_metadata
            ?.full_name ||

          user
            .user_metadata
            ?.name ||

          user
            .email
            ?.split('@')[0] ||

          'お客様'


        displayName =
          addHonorific(
            fallbackName
          )
      }


      /*
       * 記憶
       */
      if (
        profile?.memory
      ) {

        memory =
          profile.memory
      }


      /*
       * 画面
       */
      if (
        customerName
      ) {

        customerName
          .textContent =
            displayName
      }


      if (
        loginName
      ) {

        loginName
          .textContent =
            `${loginDisplayName}としてログイン中`
      }


      if (
        status
      ) {

        status
          .textContent =
            'マイクを押してね🍸'
      }


      conversationStarted =
        false


      setKeiState(
        '待ってるよ'
      )


      currentMouth =
        ''

      setMouth(
        'close'
      )


      scheduleBlink()


      if (
        voiceButton
      ) {

        voiceButton
          .disabled =
            false
      }


