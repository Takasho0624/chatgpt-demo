                  hideCocktailMenu()

                  /* 以前のカクテルがあれば一旦消す */
                  if (servedCocktail) {
                    servedCocktail.hidden = true
                  }

                  /* けいを一旦消す */
                  if (keiAvatar) {
                    keiAvatar.style.opacity = '0'
                    keiAvatar.style.visibility = 'hidden'
                  }

                  /* 1秒間、カクテルを作っている間 */
                  await new Promise(
                    resolve => setTimeout(resolve, 1000)
                  )

                  /* カクテルを表示 */
                  const cocktail =
                    serveCocktail(
                      number
                    )

                  /* けいを中央に戻して同時に表示 */
                  if (keiAvatar) {
                    keiAvatar.classList.remove(
                      'kei-avatar--menu-open'
                    )
                  
                    keiAvatar.style.left = '50%'
                    keiAvatar.style.maxWidth = '86%'
                    keiAvatar.style.visibility = 'visible'
                    keiAvatar.style.opacity = '1'
                  }

                  /* けいを中央に戻して同時に表示 */
                  if (keiAvatar) {
                    keiAvatar.classList.remove(
                      'kei-avatar--menu-open'
                    )
                  
                    keiAvatar.style.left = '50%'
                    keiAvatar.style.maxWidth = '86%'
                    keiAvatar.style.visibility = 'visible'
                    keiAvatar.style.opacity = '1'
                  }


                  if (
                    cocktail &&
                    dataChannel &&
                    dataChannel.readyState ===
                      'open'
                  ) {

                    /*
                     * Function実行結果を
                     * Realtime APIへ返す
                     */

                    dataChannel.send(
                      JSON.stringify({
                        type:
                          'conversation.item.create',

                        item: {
                          type:
                            'function_call_output',

                          call_id:
                            message.call_id,

                          output:
                            JSON.stringify({
                              success:
                                true,

                              cocktail_number:
                                number,

                              cocktail_name:
