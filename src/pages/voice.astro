---
import Layout from '../layouts/Layout.astro'
---

<Layout title="けいのBAR - Voice">
  <main class="voice-page">

    <section class="bar-card">

      <div class="title">
        けいのBAR
      </div>

      <div id="customer-name" class="customer-name">
        お客様情報を確認しています…
      </div>

      <div id="status" class="status">
        少し待ってね🍸
      </div>

      <div class="kei-area">

        <img
          id="kei-avatar"
          src="/kei-mouth-close.png"
          alt="けい"
          class="kei-avatar"
        />

        <div id="kei-state" class="kei-state">
          準備中
        </div>

      </div>

      <button
        id="voice-button"
        class="voice-button"
        type="button"
        disabled
      >
        🎙️ けいと話す
      </button>

      <button
        id="stop-button"
        class="stop-button"
        type="button"
        disabled
      >
        会話を終了
      </button>

      <audio
        id="remote-audio"
        autoplay
      ></audio>

    </section>

  </main>
</Layout>

<script>
  import { supabase } from '../utils/supabase'

  let peerConnection = null
  let localStream = null
  let dataChannel = null

  let displayName = 'お客様'
  let memory = ''

  let audioContext = null
  let analyser = null
  let remoteAudioSource = null
  let lipSyncFrame = null

  let currentMouth = 'close'
  let lastMouthChange = 0
  let silenceFrames = 0


  const CLOSED_SRC =
    '/kei-mouth-close.png'

  const SMALL_OPEN_SRC =
    '/kei-mouth-open-small.png'

  const OPEN_SRC =
    '/kei-mouth-open.png'


  const voiceButton =
    document.getElementById('voice-button')

  const stopButton =
    document.getElementById('stop-button')

  const status =
    document.getElementById('status')

  const keiState =
    document.getElementById('kei-state')

  const customerName =
    document.getElementById('customer-name')

  const remoteAudio =
    document.getElementById('remote-audio')

  const keiAvatar =
    document.getElementById('kei-avatar')


  function preloadAvatarImages() {

    [
      CLOSED_SRC,
      SMALL_OPEN_SRC,
      OPEN_SRC,
    ].forEach((src) => {

      const image =
        new Image()

      image.src =
        src
    })
  }


  function setMouth(type) {

    if (!keiAvatar) return

    if (
      currentMouth === type
    ) {
      return
    }

    currentMouth =
      type


    if (
      type === 'close'
    ) {

      keiAvatar.src =
        CLOSED_SRC
    }


    if (
      type === 'small'
    ) {

      keiAvatar.src =
        SMALL_OPEN_SRC
    }


    if (
      type === 'open'
    ) {

      keiAvatar.src =
        OPEN_SRC
    }
  }


  function stopRealLipSync() {

    if (
      lipSyncFrame
    ) {

      cancelAnimationFrame(
        lipSyncFrame
      )

      lipSyncFrame =
        null
    }


    if (
      remoteAudioSource
    ) {

      try {
        remoteAudioSource.disconnect()
      } catch (error) {
        // ignore
      }

      remoteAudioSource =
        null
    }


    analyser =
      null

    silenceFrames =
      0

    currentMouth =
      ''

    setMouth('close')
  }


  async function startRealLipSync(
    stream
  ) {

    if (!stream) return


    /*
     * 前回の解析が残っていたら停止
     */
    if (
      lipSyncFrame
    ) {

      cancelAnimationFrame(
        lipSyncFrame
      )

      lipSyncFrame =
        null
    }


    if (
      remoteAudioSource
    ) {

      try {
        remoteAudioSource.disconnect()
      } catch (error) {
        // ignore
      }

      remoteAudioSource =
        null
    }


    /*
     * AudioContext
     */
    if (
      !audioContext ||
      audioContext.state ===
      'closed'
    ) {

      audioContext =
        new AudioContext()
    }


    if (
      audioContext.state ===
      'suspended'
    ) {

      try {

        await audioContext.resume()

      } catch (error) {

        console.warn(
          'AudioContext resume error:',
          error
        )
      }
    }


    analyser =
      audioContext
        .createAnalyser()


    /*
     * 数字を大きくすると
     * 音量変化を細かく見られる
     */
    analyser.fftSize =
      512


    /*
     * 口がガチャガチャしすぎないよう
     * 少し滑らかにする
     */
    analyser.smoothingTimeConstant =
      0.65


    remoteAudioSource =
      audioContext
        .createMediaStreamSource(
          stream
        )


    remoteAudioSource
      .connect(
        analyser
      )


    const buffer =
      new Uint8Array(
        analyser.fftSize
      )


    silenceFrames =
      0


    function animate(
      now
    ) {

      if (!analyser) {
        return
      }


      analyser
        .getByteTimeDomainData(
          buffer
        )


      /*
       * RMS = 実際の音量を計算
       */
      let sum =
        0


      for (
        let i = 0;
        i < buffer.length;
        i++
      ) {

        const normalized =
          (
            buffer[i] - 128
          ) / 128


        sum +=
          normalized *
          normalized
      }


      const rms =
        Math.sqrt(
          sum /
          buffer.length
        )


      /*
       * 画像の変更頻度を制限
       * 速すぎるとパカパカしすぎる
       */
      if (
        now -
        lastMouthChange >
        85
      ) {

        let nextMouth =
          currentMouth


        /*
         * ほぼ無音
         */
        if (
          rms < 0.010
        ) {

          silenceFrames++


          /*
           * 一瞬の無音では
           * 口を閉じない
           */
          if (
            silenceFrames > 4
          ) {

            nextMouth =
              'close'
          }

        } else {

          silenceFrames =
            0


          /*
           * 小さめの声
           */
          if (
            rms < 0.025
          ) {

            nextMouth =
              'small'

          /*
           * 普通の声
           */
          } else if (
            rms < 0.055
          ) {

            /*
             * small と open を
             * 少し混ぜると自然
             */
            nextMouth =
              Math.random() <
              0.45
                ? 'small'
                : 'open'

          /*
           * 大きめの声
           */
          } else {

            nextMouth =
              'open'
          }
        }


        if (
          nextMouth !==
          currentMouth
        ) {

          setMouth(
            nextMouth
          )

          lastMouthChange =
            now
        }
      }


      lipSyncFrame =
        requestAnimationFrame(
          animate
        )
    }


    lipSyncFrame =
      requestAnimationFrame(
        animate
      )
  }


  async function initializeUser() {

    try {

      const {
        data: { user },
      } =
        await supabase
          .auth
          .getUser()


      if (!user) {

        window.location.href =
          '/password'

        return
      }


      const {
        data: profile,
        error,
      } =
        await supabase
          .from('profiles')
          .select(
            'display_name, memory, name_confirmed'
          )
          .eq(
            'user_id',
            user.id
          )
          .maybeSingle()


      if (error) {

        console.error(
          'Profile error:',
          error
        )
      }


      if (
        profile?.display_name &&
        profile
          .display_name
          .trim()
      ) {

        displayName =
          profile
            .display_name
            .trim()

      } else {

        displayName =
          user
            .user_metadata
            ?.full_name ||

          user
            .user_metadata
            ?.name ||

          user
            .email
            ?.split('@')[0] ||

          'お客様'
      }


      if (
        profile?.memory
      ) {

        memory =
          profile.memory
      }


      if (
        customerName
      ) {

        customerName
          .textContent =
            displayName
      }


      if (
        status
      ) {

        status
          .textContent =
            'マイクを押してね🍸'
      }


      if (
        keiState
      ) {

        keiState
          .textContent =
            '待ってるよ'
      }


      currentMouth =
        ''

      setMouth(
        'close'
      )


      if (
        voiceButton
      ) {

        voiceButton
          .disabled =
            false
      }


    } catch (
      error
    ) {

      console.error(
        'Initialize error:',
        error
      )


      if (
        status
      ) {

        status
          .textContent =
            'ユーザー情報を取得できませんでした'
      }
    }
  }


  async function startVoice() {

    try {

      if (
        voiceButton
      ) {

        voiceButton
          .disabled =
            true
      }


      if (
        status
      ) {

        status
          .textContent =
            '接続しています…'
      }


      if (
        keiState
      ) {

        keiState
          .textContent =
            'ちょっと待ってね'
      }


      currentMouth =
        ''

      setMouth(
        'close'
      )


      /*
       * Realtime一時キー
       */
      const tokenResponse =
        await fetch(
          '/api/realtime',
          {
            method:
              'POST',

            headers: {
              'Content-Type':
                'application/json',
            },

            body:
              JSON.stringify({
                displayName,
                memory,
              }),
          }
        )


      if (
        !tokenResponse.ok
      ) {

        throw new Error(
          await tokenResponse
            .text()
        )
      }


      const tokenData =
        await tokenResponse
          .json()


      const ephemeralKey =
        tokenData.value ||

        tokenData
          .client_secret
          ?.value ||

        tokenData
          .client_secret


      if (
        !ephemeralKey
      ) {

        console.error(
          tokenData
        )

        throw new Error(
          'Realtime token が取得できませんでした'
        )
      }


      /*
       * WebRTC
       */
      peerConnection =
        new RTCPeerConnection()


      /*
       * OpenAIから届く
       * けいの音声
       */
      if (
        remoteAudio
      ) {

        remoteAudio
          .autoplay =
            true


        peerConnection
          .ontrack =
            async (
              event
            ) => {

              const remoteStream =
                event
                  .streams[0]


              remoteAudio
                .srcObject =
                  remoteStream


              try {

                await remoteAudio
                  .play()

              } catch (
                error
              ) {

                console.warn(
                  'Audio play error:',
                  error
                )
              }


              /*
               * ここで
               * 実際のけいの音声を
               * 解析開始
               */
              await startRealLipSync(
                remoteStream
              )
            }
      }


      /*
       * お客様のマイク
       */
      localStream =
        await navigator
          .mediaDevices
          .getUserMedia({
            audio: {

              echoCancellation:
                true,

              noiseSuppression:
                true,

              autoGainControl:
                true,
            },
          })


      localStream
        .getTracks()
        .forEach(
          (
            track
          ) => {

            peerConnection
              .addTrack(
                track,
                localStream
              )
          }
        )


      /*
       * Realtimeイベント
       */
      dataChannel =
        peerConnection
          .createDataChannel(
            'oai-events'
          )


      dataChannel
        .onopen =
          () => {

            if (
              status
            ) {

              status
                .textContent =
                  'けいにつながりました🎙️'
            }


            if (
              keiState
            ) {

              keiState
                .textContent =
                  'いらっしゃいませ'
            }


            if (
              stopButton
            ) {

              stopButton
                .disabled =
                  false
            }


            /*
             * 最初の挨拶
             */
            dataChannel
              .send(
                JSON.stringify({
                  type:
                    'response.create',

                  response: {

                    instructions: `
お客様が来店しました。

最初の一言として、
自然に「いらっしゃいませ」と挨拶してください。

お客様の呼び名は
「${displayName}」です。

名前を自然に入れても構いません。

たとえば、

「いらっしゃいませ、${displayName}」

のような感じです。

ただし、
定型文を読み上げるような
堅い接客口調にはしないでください。

すでに知っているお客様を
迎えるような、
自然で親しみのある挨拶にしてください。

くつろいでもらう意味で
声をかける場合は、

「ゆっくりしていってね」

という表現を使ってください。

「ゆっくり見ていってね」

とは言わないでください。

ここは商品を見る店ではなく、
会話やお酒を楽しみながら
ゆっくり過ごすバーです。

挨拶のあと、
軽く一言話しかけてください。
                    `.trim(),
                  },
                })
              )
          }


      dataChannel
        .onmessage =
          (
            event
          ) => {

            try {

              const message =
                JSON.parse(
                  event.data
                )


              /*
               * お客様が話し始めた
               */
              if (
                message.type ===
                'input_audio_buffer.speech_started'
              ) {

                if (
                  status
                ) {

                  status
                    .textContent =
                      '聞いてるよ…'
                }


                if (
                  keiState
                ) {

                  keiState
                    .textContent =
                      '👂'
                }
              }


              /*
               * お客様が話し終わった
               */
              if (
                message.type ===
                'input_audio_buffer.speech_stopped'
              ) {

                if (
                  status
                ) {

                  status
                    .textContent =
                      'けいが考えています…'
                }


                if (
                  keiState
                ) {

                  keiState
                    .textContent =
                      'んー'
                }
              }


              /*
               * けいが話している
               *
               * ここでは画像は触らない
               * 口は実際の音声波形で動く
               */
              if (
                message.type ===
                'response.audio.delta'
              ) {

                if (
                  status
                ) {

                  status
                    .textContent =
                      'けいが話しています'
                }


                if (
                  keiState
                ) {

                  keiState
                    .textContent =
                      '♪'
                }
              }


              /*
               * 返答生成終了
               *
               * ここでも口は閉じない
               * 実音声がなくなったら
               * 波形解析が自動で閉じる
               */
              if (
                message.type ===
                'response.done'
              ) {

                if (
                  status
                ) {

                  status
                    .textContent =
                      '話しかけてね🎙️'
                }


                if (
                  keiState
                ) {

                  keiState
                    .textContent =
                      '聞いてるよ'
                }
              }


              /*
               * APIエラー
               */
              if (
                message.type ===
                'error'
              ) {

                console.error(
                  'Realtime API error:',
                  message
                )


                if (
                  status
                ) {

                  status
                    .textContent =
                      '音声APIでエラーが出ました'
                }
              }


            } catch (
              error
            ) {

              console.error(
                'Realtime message error:',
                error
              )
            }
          }


      /*
       * WebRTC Offer
       */
      const offer =
        await peerConnection
          .createOffer()


      await peerConnection
        .setLocalDescription(
          offer
        )


      /*
       * OpenAIへSDP
       */
      const sdpResponse =
        await fetch(
          'https://api.openai.com/v1/realtime/calls',
          {
            method:
              'POST',

            headers: {

              Authorization:
                `Bearer ${ephemeralKey}`,

              'Content-Type':
                'application/sdp',
            },

            body:
              peerConnection
                .localDescription
                .sdp,
          }
        )


      if (
        !sdpResponse.ok
      ) {

        throw new Error(
          await sdpResponse
            .text()
        )
      }


      const answerSdp =
        await sdpResponse
          .text()


      await peerConnection
        .setRemoteDescription({
          type:
            'answer',

          sdp:
            answerSdp,
        })


    } catch (
      error
    ) {

      console.error(
        'Voice start error:',
        error
      )


      if (
        status
      ) {

        status
          .textContent =
            '接続できませんでした'
      }


      if (
        keiState
      ) {

        keiState
          .textContent =
            'ごめん💦'
      }


      stopVoice()
    }
  }


  function stopVoice() {

    stopRealLipSync()


    if (
      dataChannel
    ) {

      dataChannel
        .close()

      dataChannel =
        null
    }


    if (
      peerConnection
    ) {

      peerConnection
        .close()

      peerConnection =
        null
    }


    if (
      localStream
    ) {

      localStream
        .getTracks()
        .forEach(
          (
            track
          ) => {

            track
              .stop()
          }
        )

      localStream =
        null
    }


    if (
      remoteAudio
    ) {

      remoteAudio
        .srcObject =
          null
    }


    if (
      audioContext &&
      audioContext.state !==
      'closed'
    ) {

      audioContext
        .suspend()
    }


    if (
      status
    ) {

      status
        .textContent =
          'マイクを押してね🍸'
    }


    if (
      keiState
    ) {

      keiState
        .textContent =
          '待ってるよ'
    }


    currentMouth =
      ''

    setMouth(
      'close'
    )


    if (
      voiceButton
    ) {

      voiceButton
        .disabled =
          false
    }


    if (
      stopButton
    ) {

      stopButton
        .disabled =
          true
    }
  }


  voiceButton
    ?.addEventListener(
      'click',
      startVoice
    )


  stopButton
    ?.addEventListener(
      'click',
      stopVoice
    )


  window
    .addEventListener(
      'beforeunload',
      stopVoice
    )


  preloadAvatarImages()

  initializeUser()
</script>


<style>

.voice-page {

  min-height:
    100vh;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  padding:
    20px;

  background:
    radial-gradient(
      circle at center,
      #392116,
      #120907 70%
    );

  color:
    white;
}


.bar-card {

  width:
    min(
      94vw,
      560px
    );

  padding:
    28px 24px 32px;

  text-align:
    center;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      .15
    );

  border-radius:
    22px;

  background:
    rgba(
      10,
      5,
      3,
      .72
    );

  box-shadow:
    0
    20px
    70px
    rgba(
      0,
      0,
      0,
      .45
    );

  overflow:
    hidden;
}


.title {

  margin-bottom:
    8px;

  font-size:
    25px;

  font-weight:
    bold;

  letter-spacing:
    .06em;
}


.customer-name {

  margin-bottom:
    12px;

  font-size:
    13px;

  color:
    rgba(
      255,
      255,
      255,
      .58
    );
}


.status {

  min-height:
    24px;

  margin-bottom:
    16px;

  font-size:
    14px;

  color:
    rgba(
      255,
      255,
      255,
      .72
    );
}


.kei-area {

  margin-bottom:
    24px;
}


.kei-avatar {

  display:
    block;

  width:
    min(
      88vw,
      500px
    );

  max-height:
    560px;

  height:
    auto;

  margin:
    0 auto 12px;

  object-fit:
    contain;

  object-position:
    center bottom;

  filter:
    drop-shadow(
      0
      18px
      30px
      rgba(
        0,
        0,
        0,
        .38
      )
    );

  user-select:
    none;

  -webkit-user-drag:
    none;
}


.kei-state {

  min-height:
    20px;

  font-size:
    14px;

  color:
    rgba(
      255,
      255,
      255,
      .8
    );
}


.voice-button,
.stop-button {

  width:
    100%;

  padding:
    15px 20px;

  border:
    none;

  border-radius:
    12px;

  font-size:
    16px;

  cursor:
    pointer;
}


.voice-button {

  margin-bottom:
    12px;

  background:
    #f6eee7;

  color:
    #24120d;
}


.voice-button:hover {

  opacity:
    .92;
}


.voice-button:disabled {

  opacity:
    .45;

  cursor:
    default;
}


.stop-button {

  background:
    rgba(
      255,
      255,
      255,
      .08
    );

  color:
    white;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      .18
    );
}


.stop-button:disabled {

  opacity:
    .35;

  cursor:
    default;
}


@media (
  max-width: 640px
) {

  .voice-page {

    padding:
      8px;
  }


  .bar-card {

    width:
      100%;

    padding:
      22px 14px 24px;
  }


  .kei-avatar {

    width:
      min(
        96vw,
        460px
      );

    max-height:
      58vh;
  }
}

</style>
