  /*
   * =========================
   * Web検索
   * =========================
   */

  async function handleWebSearch(
    message
  ) {

    if (
      !dataChannel ||
      dataChannel.readyState !==
        'open'
    ) {

      return
    }


    const callId =
      message.call_id


    if (!callId) {

      console.error(
        'search_web: call_id がありません',
        message
      )

      return
    }


    if (
      handledToolCalls
        .has(callId)
    ) {

      return
    }


    handledToolCalls
      .add(callId)


    let args = {}


    try {

      args =
        JSON.parse(
          message.arguments ||
          '{}'
        )

    } catch (error) {

      console.error(
        'Tool arguments parse error:',
        error
      )
    }


    const query =
      typeof args.query ===
        'string'
        ? args.query.trim()
        : ''


    /*
     * 検索語なし
     */
    if (!query) {

      dataChannel.send(
        JSON.stringify({
          type:
            'conversation.item.create',

          item: {
            type:
              'function_call_output',

            call_id:
              callId,

            output:
              '検索キーワードが取得できませんでした。',
          },
        })
      )


      dataChannel.send(
        JSON.stringify({
          type:
            'response.create',
        })
      )


      return
    }


    if (
      status
    ) {

      status.textContent =
        '調べてるよ…🌐'
    }


    setKeiState('')


    try {

      const response =
        await fetch(
          '/api/web-search',
          {
            method:
              'POST',

            headers: {
              'Content-Type':
                'application/json',
            },

            body:
              JSON.stringify({
                query,
              }),
          }
        )


      const result =
        await response
          .json()


      let answer =
        ''


      if (
        response.ok &&
        typeof result.answer ===
          'string'
      ) {

        answer =
          result.answer.trim()

      } else {

        answer =
          'Web検索を試しましたが、今回は情報を取得できませんでした。'
      }


      dataChannel.send(
        JSON.stringify({
          type:
            'conversation.item.create',

          item: {
            type:
              'function_call_output',

            call_id:
              callId,

            output:
              answer,
          },
        })
      )


      dataChannel.send(
        JSON.stringify({
          type:
            'response.create',

          response: {
            instructions: `
search_web の検索結果が返ってきました。

検索結果を踏まえて、
お客様の元の質問に答えてください。

検索結果をそのまま読み上げるのではなく、
内容を理解したうえで、
けい自身の自然な会話として説明してください。

なるべく短く答えてください。

URLは読み上げないでください。

検索結果に不確かな点がある場合は、
断定しないでください。
            `.trim(),
          },
        })
      )


      if (
        status
      ) {

        status.textContent =
          'ちょっと待ってね…'
      }


    } catch (
      error
    ) {

      console.error(
        'Web search error:',
        error
      )


      dataChannel.send(
        JSON.stringify({
          type:
            'conversation.item.create',

          item: {
            type:
              'function_call_output',

            call_id:
              callId,

            output:
              'Web検索中にエラーが発生し、最新情報を取得できませんでした。',
          },
        })
      )


      dataChannel.send(
        JSON.stringify({
          type:
            'response.create',

          response: {
            instructions: `
Web検索がうまくいきませんでした。

知っているふりをせず、
自然な会話として短く伝えてください。
            `.trim(),
          },
        })
      )
    }
  }


  /*
   * =========================
   * 音声開始
   * =========================
   */

  // VOICE_TRIAL_TIMER_START
  let voiceTrialMode = true
  let voiceTrialStarted = false
  let voiceTrialExpired = false
  let voiceTrialWarningTimer = null
  let voiceTrialEndTimer = null

  const trialModeButton =
    document.getElementById('trial-mode-button')

  function updateVoiceTrialButton() {
    if (!trialModeButton)
      return

    trialModeButton.textContent =
      voiceTrialMode
        ? '試用モード：ON（10分）'
        : '試用モード：OFF（無制限）'
  }

  function clearVoiceTrialTimers() {
    if (voiceTrialWarningTimer) {
      clearTimeout(voiceTrialWarningTimer)
      voiceTrialWarningTimer = null
    }

    if (voiceTrialEndTimer) {
      clearTimeout(voiceTrialEndTimer)
      voiceTrialEndTimer = null
    }
  }

  function startVoiceTrialTimer() {
    if (!voiceTrialMode || voiceTrialStarted)
      return

    voiceTrialStarted = true

    // 9分後に残り1分を警告
    voiceTrialWarningTimer = setTimeout(() => {
      if (status)
        status.textContent = '⏱ 試用時間は残り1分です。'
    }, 9 * 60 * 1000)

    // 10分後に終了
    voiceTrialEndTimer = setTimeout(() => {
      voiceTrialExpired = true

      stopVoice()

      if (status)
        status.textContent =
          '試用時間が終了しました。ご利用ありがとうございました。'

      if (voiceButton)
        voiceButton.disabled = true
    }, 10 * 60 * 1000)
  }

  trialModeButton?.addEventListener('click', () => {
    voiceTrialMode = !voiceTrialMode

    if (!voiceTrialMode) {
      clearVoiceTrialTimers()
      voiceTrialStarted = false
      voiceTrialExpired = false

      if (voiceButton)
        voiceButton.disabled = false
    }

    updateVoiceTrialButton()
  })
  // VOICE_TRIAL_TIMER_END

  async function startVoice() {
    if (voiceTrialMode && voiceTrialExpired)
      return

    startVoiceTrialTimer()


    try {

      /*
       * 新しいVOICEセッション
       */
      currentVoiceSessionId =
        createVoiceSessionId()


      /*
       * 二重保存情報をリセット
       */
      savedTranscriptKeys
        .clear()


      /*
       * 会話開始
       */
      conversationStarted =
        true


      setKeiState('')


      handledToolCalls
        .clear()


      if (
        voiceButton
      ) {

        voiceButton
          .disabled =
            true
      }


      if (
        status
      ) {

        status
          .textContent =
            'つないでるよ…'
      }


      currentMouth =
        ''

      setMouth(
        'close'
      )


      /*
       * =========================
       * 現在の日本時間を取得
       * =========================
       */

      const japanTime =
        getJapanTimeInfo()


      /*
       * =========================
       * Realtime token
       * =========================
       */

      const tokenResponse =
        await fetch(
          '/api/realtime',
          {
            method:
              'POST',

            headers: {
              'Content-Type':
                'application/json',
            },

            body:
              JSON.stringify({

                displayName,

                memory,

                /*
                 * Realtimeのけいにも
                 * セッション開始時刻を渡す
                 */
                currentTime:
                  japanTime.text,

                currentHour:
                  japanTime.hour,
              }),
          }
        )


      if (
        !tokenResponse.ok
      ) {

        throw new Error(
          await tokenResponse
            .text()
        )
      }


      const tokenData =
        await tokenResponse
          .json()


      const ephemeralKey =
        tokenData.value ||

        tokenData
          .client_secret
          ?.value ||

        tokenData
          .client_secret


      if (
        !ephemeralKey
      ) {

        console.error(
          tokenData
        )

        throw new Error(
          'Realtime token が取得できませんでした'
        )
      }


      /*
       * =========================
       * WebRTC
       * =========================
       */

      peerConnection =
        new RTCPeerConnection()


      /*
       * けいの音声
       */
      if (
        remoteAudio
      ) {

        remoteAudio
          .autoplay =
            true


        peerConnection
          .ontrack =
            async (
              event
            ) => {

              const remoteStream =
                event
                  .streams[0]


              remoteAudio
                .srcObject =
                  remoteStream


              try {

                await remoteAudio
                  .play()

              } catch (
                error
              ) {

                console.warn(
                  'Audio play error:',
                  error
                )
              }


              /*
               * 実音声で
               * リップシンク
               */
              await startRealLipSync(
                remoteStream
              )
            }
      }


      /*
       * =========================
       * お客様マイク
       * =========================
       */

      localStream =
        await navigator
          .mediaDevices
          .getUserMedia({
            audio: {

              echoCancellation:
                true,

              noiseSuppression:
                true,

              autoGainControl:
                true,
            },
          })


      localStream
        .getTracks()
        .forEach(
          (
            track
          ) => {

            peerConnection
              .addTrack(
                track,
                localStream
              )
          }
        )


      /*
       * =========================
       * DataChannel
       * =========================
       */

      dataChannel =
        peerConnection
          .createDataChannel(
            'oai-events'
          )


      dataChannel
        .onopen =
          () => {

            /* COCKTAIL_MENU_OPENING_ADDED */
            showCocktailMenu()

            setKeiState('')


            if (
              status
            ) {

              status
                .textContent =
                  'つながったよ🎙️'
            }


            if (
              stopButton
            ) {

              stopButton
                .disabled =
                  false
            }


            /*
             * =========================
             * 最初の挨拶
             *
             * 時刻を必ず確認してから
             * 自然に挨拶する
             * =========================
             */

            const openingJapanTime =
              getJapanTimeInfo()


            dataChannel
              .send(
                JSON.stringify({
                  type:
                    'response.create',

                  response: {

                    instructions: `
お客様が来店しました。

現在、画面にはスタンダードカクテルのメニューが表示されています。

時間帯に合った自然な挨拶をしたあと、
続けてメニューについて短く案内してください。

案内は、
「こちらがスタンダードカクテルのメニューです。
気になるものがあったら、名前か番号で言ってね。
どんなカクテルかわからなかったら聞いてね。説明するから」
という内容を、けいらしい自然な話し方で伝えてください。

長々と説明せず、
お客様が選んだり質問したりできるところで止めてください。

現在の日本時間は
「${openingJapanTime.text}」
です。

まず必ず現在時刻を認識したうえで、
その時間帯に自然に合った挨拶をしてください。

現在時刻そのものを
機械的に読み上げる必要はありません。

朝なら朝らしく、
昼なら昼らしく、
夕方なら夕方らしく、
夜なら夜らしく、
深夜なら深夜らしく、
自然に反応してください。

例えば深夜であれば、
会話の雰囲気に合う場合には、

「こんな時間まで起きてたんだね」

「ずいぶん遅い時間だね」

などのように、
時間を踏まえた自然な一言を入れて構いません。

ただし、
毎回決まった文句を使わず、
人間らしく自然に変えてください。

自然に
「いらっしゃいませ」
と挨拶してください。

お客様の呼び名は
「${displayName}」
です。

すでに知っているお客様を迎えるような、
親しみのある短い挨拶にしてください。

必要なら
「ゆっくりしていってね」
と言ってください。

「ゆっくり見ていってね」
とは言わないでください。

明るく元気すぎる挨拶にはせず、
夜のオーセンティックなBARらしい、
静かで柔らかい雰囲気を保ってください。

挨拶は長くしないでください。
                    `.trim(),
                  },
                })
              )
          }


      /*
       * =========================
       * Realtimeイベント
       * =========================
       */

      dataChannel
        .onmessage =
          async (
            event
          ) => {

            try {

              const message =
                JSON.parse(
                  event.data
                )


              /*
               * =========================
               * お客様の文字起こし確定
               * =========================
               */

              if (
                message.type ===
                'conversation.item.input_audio_transcription.completed'
              ) {

                const transcript =
                  typeof message.transcript ===
                    'string'
                    ? message.transcript.trim()
                    : ''


                if (transcript) {

                  const itemId =
                    message.item_id ||
                    'unknown'


                  await saveVoiceMessage(
                    'user',
                    transcript,
                    `user:${itemId}`
                  )
                }
              }


              /*
               * =========================
               * けいの文字起こし確定
               * =========================
               */

              if (
                message.type ===
                'response.output_audio_transcript.done'
              ) {

                const transcript =
                  typeof message.transcript ===
                    'string'
                    ? message.transcript.trim()
                    : ''


                if (transcript) {

                  const itemId =
                    message.item_id ||
                    message.response_id ||
                    'unknown'


                  await saveVoiceMessage(
                    'assistant',
                    transcript,
                    `assistant:${itemId}`
                  )
                }
              }


              /*
               * 旧形式にも対応
               */
              if (
                message.type ===
                'response.audio_transcript.done'
              ) {

                const transcript =
                  typeof message.transcript ===
                    'string'
                    ? message.transcript.trim()
                    : ''


                if (transcript) {

                  const itemId =
                    message.item_id ||
                    message.response_id ||
                    'unknown'


                  await saveVoiceMessage(
                    'assistant',
                    transcript,
                    `assistant:${itemId}`
                  )
                }
              }


              /*
               * =========================
               * お客様が話し始めた
               * =========================
               */

              if (
                message.type ===
                'input_audio_buffer.speech_started'
              ) {

                if (
                  status
                ) {

                  status
                    .textContent =
                      'うんうん…'
                }


                setKeiState('')
              }


              /*
               * =========================
               * お客様が話し終わった
               * =========================
               */

              if (
                message.type ===
                'input_audio_buffer.speech_stopped'
              ) {

                if (
                  status
                ) {

                  status
                    .textContent =
                      'ちょっと考えてる…'
                }


                setKeiState('')
              }


              /*
               * =========================
               * けいが話している
               * =========================
               */

              if (
                message.type ===
                  'response.audio.delta' ||

                message.type ===
                  'response.output_audio.delta'
              ) {

                isKeiSpeaking =
                  true


                if (
                  status
                ) {

                  status
                    .textContent =
                      ''
                }


                setKeiState('')
              }



              /*
               * =========================
               * カクテル提供
               * =========================
               */

              if (
                message.type ===
                  'response.function_call_arguments.done' &&
                message.name ===
