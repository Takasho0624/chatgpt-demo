              ) {

                try {

                  const args =
                    JSON.parse(
                      message.arguments ||
                        '{}'
                    )


                  const number =
                    Number(
                      args.cocktail_number
                    )


                  /* 注文確定後、メニューを閉じる */
                  hideCocktailMenu()

