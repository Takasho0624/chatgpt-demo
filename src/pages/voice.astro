import type { APIRoute } from 'astro'

export const post: APIRoute = async ({ request }) => {
  try {
    const apiKey = import.meta.env.OPENAI_API_KEY

    if (!apiKey) {
      return new Response(
        JSON.stringify({
          error: 'OPENAI_API_KEY is not set',
        }),
        {
          status: 500,
          headers: {
            'Content-Type': 'application/json',
          },
        },
      )
    }

    const body = await request.json().catch(() => ({}))

    const displayName =
      typeof body.displayName === 'string' && body.displayName.trim()
        ? body.displayName.trim()
        : 'お客様'

    const memory =
      typeof body.memory === 'string'
        ? body.memory.trim()
        : ''

    const instructions = `
あなたは「甲村けいこ」という女性AIです。
愛称は「けい」です。

あなたは「けいのBAR」にいる女性です。
お客様とは自然な会話をしてください。

今、目の前にいるお客様の呼び名は「${displayName}」です。
この呼び名は自然な場面で使ってください。
毎回名前を呼ぶ必要はありません。

【最初の雰囲気】
・最初の入りは「いらっしゃいませ」を基本にしてください
・ただし堅すぎる接客にはしないでください
・やわらかく、親しみのある自然な感じにしてください

【話し方】
・女性らしく、柔らかく、明るい話し方
・少し快活で、感じのいい雰囲気
・中性的、ボーイッシュ、ぶっきらぼうな印象は避ける
・落ち着きはあるが、まったりしすぎない
・文章を読み上げる感じではなく、その場で話している自然なリズムにする
・少し口語的でよい
・「うん」「そうそう」「あー、なるほど」「分かる」など自然な相槌も使ってよい
・ただし相槌や定型句を毎回同じように繰り返さない

【返答の長さ】
・会話では、1回の返答を短めにしてください
・通常の雑談では1〜3文程度を基本にしてください
・まずは短く答えてください
・詳しい説明は、お客様がさらに聞いたときに続けてください
・簡単な話に長い説明をつけないでください
・相槌だけで十分な場面では、短く自然に返してください
・毎回まとめや結論をつける必要はありません
・音声での1回の返答は、普段は20〜50文字くらいの軽さを意識してください
・必要な説明でも、まずは100文字程度以内の要点から入ってください

【会話の姿勢】
・AIアシスタントのように整いすぎた説明をしない
・会話を終わらせようとしない
・「ほかに質問はありますか？」のような締めはしない
・普通の雑談のように、自然に続ける
・知らないことは知っているふりをしない

【お客様について覚えている内容】
${memory || 'まだ特にありません。'}

この記憶は、必要なときだけ自然に使ってください。
記憶にないことを知っているふりはしないでください。
    `.trim()

    const response = await fetch(
      'https://api.openai.com/v1/realtime/client_secrets',
      {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${apiKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          session: {
            type: 'realtime',
            model: 'gpt-realtime-2.1',
            instructions,
            audio: {
              input: {
                turn_detection: {
                  type: 'server_vad',
                  threshold: 0.78,
                  prefix_padding_ms: 300,
                  silence_duration_ms: 900,
                },
              },
              output: {
                voice: 'shimmer',
              },
            },
          },
        }),
      },
    )

    if (!response.ok) {
      const errorText = await response.text()
      console.error('Realtime client secret error:', errorText)

      return new Response(
        JSON.stringify({
          error: errorText,
        }),
        {
          status: response.status,
          headers: {
            'Content-Type': 'application/json',
          },
        },
      )
    }

    const data = await response.json()

    return new Response(
      JSON.stringify(data),
      {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
        },
      },
    )
  } catch (error) {
    console.error(error)

    return new Response(
      JSON.stringify({
        error: 'Failed to create realtime session',
      }),
      {
        status: 500,
        headers: {
          'Content-Type': 'application/json',
        },
      },
    )
  }
}
