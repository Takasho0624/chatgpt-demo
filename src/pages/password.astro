---
import Layout from '../layouts/Layout.astro'
---

<Layout title="けいのBAR ログイン">
  <main class="login-page">

    <div class="login-card">

      <div id="main-area">

        <div class="login-title">
          けいのBARへようこそ
        </div>

        <div
          id="login-description"
          class="login-text"
        >
          Googleアカウント、またはメールアドレスでご入店ください
        </div>


        <!-- =========================
             Googleログイン
             ========================= -->

        <div
          id="login-google-area"
          class="google-area"
        >

          <button
            id="google-login"
            class="google-button"
            type="button"
          >
            <svg
              class="google-logo"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill="#4285F4"
                d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.33 2.98-7.38Z"
              />
              <path
                fill="#34A853"
                d="M12 22c2.7 0 4.97-.9 6.63-2.39l-3.24-2.51c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.59A10 10 0 0 0 12 22Z"
              />
              <path
                fill="#FBBC05"
                d="M6.39 13.93A6.02 6.02 0 0 1 6.08 12c0-.67.11-1.32.31-1.93V7.48H3.04A10 10 0 0 0 2 12c0 1.61.39 3.13 1.04 4.52l3.35-2.59Z"
              />
              <path
                fill="#EA4335"
                d="M12 5.94c1.47 0 2.78.51 3.82 1.5l2.87-2.87C16.96 2.96 14.7 2 12 2a10 10 0 0 0-8.96 5.48l3.35 2.59C7.18 7.7 9.39 5.94 12 5.94Z"
              />
            </svg>

            <span>
              Googleでログイン
            </span>
          </button>

        </div>


        <!-- =========================
             ログイン用区切り
             ========================= -->

        <div
          id="login-divider"
          class="divider"
        >

          <span></span>

          <div>
            または
          </div>

          <span></span>

        </div>


        <!-- =========================
             メールログイン
             ========================= -->

        <div
          id="login-panel"
          class="auth-panel"
        >

          <div class="panel-title">
            メールアドレスでログイン
          </div>


          <label
            for="login-email"
            class="field-label"
          >
            メールアドレス
          </label>

          <input
            id="login-email"
            class="field-input"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="example@example.com"
          />


          <label
            for="login-password"
            class="field-label password-label"
          >
            パスワード
          </label>

          <div class="password-wrapper">

            <input
              id="login-password"
              class="field-input password-input"
              type="password"
              autocomplete="current-password"
              placeholder="パスワード"
            />

            <button
              class="password-toggle"
              type="button"
              data-target="login-password"
              aria-label="パスワードを表示"
            >
              表示
            </button>

          </div>


          <button
            id="email-login"
            class="primary-button"
            type="button"
          >
            ログイン
          </button>


          <button
            id="show-forgot"
            class="text-button"
            type="button"
          >
            パスワードを忘れた方
          </button>


          <div class="new-user-area">

            <span>
              はじめての方は
            </span>

            <button
              id="show-signup"
              class="inline-button"
              type="button"
            >
              新規登録
            </button>

          </div>

        </div>


        <!-- =========================
             新規登録
             ========================= -->

        <div
          id="signup-panel"
          class="auth-panel hidden"
        >

          <div class="panel-title">
            新規登録
          </div>

          <div class="panel-description">
            まず、けいがお呼びするニックネームを決めてください。
          </div>


          <label
            for="signup-nickname"
            class="field-label"
          >
            ニックネーム
          </label>

          <input
            id="signup-nickname"
            class="field-input"
            type="text"
            autocomplete="nickname"
            maxlength="30"
            placeholder="例）けいちゃん"
          />


          <!-- =========================
               Google新規登録
               ========================= -->

          <button
            id="google-signup"
            class="google-button signup-google-button"
            type="button"
          >
            <svg
              class="google-logo"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill="#4285F4"
                d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.33 2.98-7.38Z"
              />
              <path
                fill="#34A853"
                d="M12 22c2.7 0 4.97-.9 6.63-2.39l-3.24-2.51c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.59A10 10 0 0 0 12 22Z"
              />
              <path
                fill="#FBBC05"
                d="M6.39 13.93A6.02 6.02 0 0 1 6.08 12c0-.67.11-1.32.31-1.93V7.48H3.04A10 10 0 0 0 2 12c0 1.61.39 3.13 1.04 4.52l3.35-2.59Z"
              />
              <path
                fill="#EA4335"
                d="M12 5.94c1.47 0 2.78.51 3.82 1.5l2.87-2.87C16.96 2.96 14.7 2 12 2a10 10 0 0 0-8.96 5.48l3.35 2.59C7.18 7.7 9.39 5.94 12 5.94Z"
              />
            </svg>

            <span>
              Googleで新規登録
            </span>
          </button>


          <div class="signup-note">
            Googleで登録する場合は、ニックネームだけ入力してください
          </div>


          <!-- =========================
               新規登録用区切り
               ========================= -->

          <div class="divider">

            <span></span>

            <div>
              または
            </div>

            <span></span>

          </div>


          <!-- =========================
               メール新規登録
               ========================= -->

          <div class="signup-mail-title">
            メールアドレスで新規登録
          </div>


          <label
            for="signup-email"
            class="field-label"
          >
            メールアドレス
          </label>

          <input
            id="signup-email"
            class="field-input"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="example@example.com"
          />


          <label
            for="signup-password"
            class="field-label password-label"
          >
            パスワード
          </label>

          <div class="password-wrapper">

            <input
              id="signup-password"
              class="field-input password-input"
              type="password"
              autocomplete="new-password"
              placeholder="6文字以上のパスワード"
            />

            <button
              class="password-toggle"
              type="button"
              data-target="signup-password"
              aria-label="パスワードを表示"
            >
              表示
            </button>

          </div>


          <label
            for="signup-password-confirm"
            class="field-label password-label"
          >
            パスワード確認
          </label>

          <div class="password-wrapper">

            <input
              id="signup-password-confirm"
              class="field-input password-input"
              type="password"
              autocomplete="new-password"
              placeholder="もう一度入力してください"
            />

            <button
              class="password-toggle"
              type="button"
              data-target="signup-password-confirm"
              aria-label="パスワードを表示"
            >
              表示
            </button>

          </div>


          <button
            id="signup-button"
            class="primary-button"
            type="button"
          >
            メールアドレスで新規登録
          </button>


          <button
            id="back-from-signup"
            class="text-button"
            type="button"
          >
            ← ログイン画面へ戻る
          </button>

        </div>


        <!-- =========================
             パスワード再設定
             ========================= -->

        <div
          id="forgot-panel"
          class="auth-panel hidden"
        >

          <div class="panel-title">
            パスワード再設定
          </div>

          <div class="panel-description">
            登録したメールアドレスを入力してください。
            新しいパスワードを設定するためのメールを送ります。
          </div>


          <label
            for="forgot-email"
            class="field-label"
          >
            メールアドレス
          </label>

          <input
            id="forgot-email"
            class="field-input"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="example@example.com"
          />


          <button
            id="forgot-button"
            class="primary-button"
            type="button"
          >
            再設定メールを送る
          </button>


          <button
            id="back-from-forgot"
            class="text-button"
            type="button"
          >
            ← ログイン画面へ戻る
          </button>

        </div>


        <div
          id="auth-message"
          class="auth-message"
        ></div>


        <div class="login-note">
          ご登録いただいたニックネーム、会話履歴、記憶は、
          ログインしたアカウントごとに保存されます。
        </div>

      </div>


      <!-- =========================
           登録確認メール送信完了
           ========================= -->

      <div
        id="signup-success-screen"
        class="signup-success-screen hidden"
      >

        <div class="success-icon">
          🍸
        </div>

        <div class="success-title">
          登録確認メールを送りました
        </div>

        <div class="success-text">

          ご登録いただいたメールアドレスに
          確認メールをお送りしました。

          <br /><br />

          メール内の

          <strong>
            「けいのBARへ入店する」
          </strong>

          を押して登録を完了してください。

        </div>


        <div
          id="signup-success-email"
          class="success-email"
        ></div>


        <div class="success-note">
          メールが届かない場合は、
          迷惑メールフォルダもご確認ください。
        </div>

      </div>

    </div>

  </main>
</Layout>


<script>
  import { supabase } from '../utils/supabase'


  const GOOGLE_NICKNAME_KEY =
    'kei_bar_pending_google_nickname'


  const EMAIL_NICKNAME_KEY =
    'kei_bar_pending_email_nickname'


  const mainArea =
    document.getElementById(
      'main-area'
    )


  const signupSuccessScreen =
    document.getElementById(
      'signup-success-screen'
    )


  const signupSuccessEmail =
    document.getElementById(
      'signup-success-email'
    )


  const loginDescription =
    document.getElementById(
      'login-description'
    )


  const loginGoogleArea =
    document.getElementById(
      'login-google-area'
    )


  const loginDivider =
    document.getElementById(
      'login-divider'
    )


  const googleLoginButton =
    document.getElementById(
      'google-login'
    ) as HTMLButtonElement | null


  const googleSignupButton =
    document.getElementById(
      'google-signup'
    ) as HTMLButtonElement | null


  const loginPanel =
    document.getElementById(
      'login-panel'
    )


  const signupPanel =
    document.getElementById(
      'signup-panel'
    )


  const forgotPanel =
    document.getElementById(
      'forgot-panel'
    )


  const loginEmail =
    document.getElementById(
      'login-email'
    ) as HTMLInputElement | null


  const loginPassword =
    document.getElementById(
      'login-password'
    ) as HTMLInputElement | null


  const emailLoginButton =
    document.getElementById(
      'email-login'
    ) as HTMLButtonElement | null


  const showSignupButton =
    document.getElementById(
      'show-signup'
    )


  const showForgotButton =
    document.getElementById(
      'show-forgot'
    )


  const signupNickname =
    document.getElementById(
      'signup-nickname'
    ) as HTMLInputElement | null


  const signupEmail =
    document.getElementById(
      'signup-email'
    ) as HTMLInputElement | null


  const signupPassword =
    document.getElementById(
      'signup-password'
    ) as HTMLInputElement | null


  const signupPasswordConfirm =
    document.getElementById(
      'signup-password-confirm'
    ) as HTMLInputElement | null


  const signupButton =
    document.getElementById(
      'signup-button'
    ) as HTMLButtonElement | null


  const forgotEmail =
    document.getElementById(
      'forgot-email'
    ) as HTMLInputElement | null


  const forgotButton =
    document.getElementById(
      'forgot-button'
    ) as HTMLButtonElement | null


  const backFromSignup =
    document.getElementById(
      'back-from-signup'
    )


  const backFromForgot =
    document.getElementById(
      'back-from-forgot'
    )


  const authMessage =
    document.getElementById(
      'auth-message'
    )


  function setMessage(
    text = '',
    type = ''
  ) {

    if (!authMessage) {
      return
    }


    authMessage.textContent =
      text


    authMessage.classList.remove(
      'success',
      'error'
    )


    if (type) {

      authMessage.classList.add(
        type
      )
    }
  }


  function isValidEmail(
    email: string
  ) {

    return (
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/
        .test(email)
    )
  }


  function cleanNickname(
    nickname?: string | null
  ) {

    return (
      nickname
        ?.replace(
          /^[「『"'“”]+/,
          ''
        )
        ?.replace(
          /[」』"'“”]+$/,
          ''
        )
        ?.trim() || ''
    )
  }


  /*
   * =========================
   * パスワード表示切替
   * =========================
   */

  document
    .querySelectorAll<HTMLButtonElement>(
      '.password-toggle'
    )
    .forEach(
      (
        button
      ) => {

        button.addEventListener(
          'click',
          () => {

            const targetId =
              button.getAttribute(
                'data-target'
              )


            if (!targetId) {
              return
            }


            const input =
              document.getElementById(
                targetId
              ) as HTMLInputElement | null


            if (!input) {
              return
            }


            const isPassword =
              input.type ===
              'password'


            input.type =
              isPassword
                ? 'text'
                : 'password'


            button.textContent =
              isPassword
                ? '隠す'
                : '表示'


            button.classList.toggle(
              'visible',
              isPassword
            )


            button.setAttribute(
              'aria-label',
              isPassword
                ? 'パスワードを隠す'
                : 'パスワードを表示'
            )
          }
        )
      }
    )


  /*
   * =========================
   * パネル切替
   * =========================
   */

  function showPanel(
    panelName:
      'login' |
      'signup' |
      'forgot'
  ) {

    loginPanel
      ?.classList
      .add('hidden')


    signupPanel
      ?.classList
      .add('hidden')


    forgotPanel
      ?.classList
      .add('hidden')


    loginGoogleArea
      ?.classList
      .add('hidden')


    loginDivider
      ?.classList
      .add('hidden')


    if (
      panelName ===
      'login'
    ) {

      loginPanel
        ?.classList
        .remove('hidden')


      loginGoogleArea
        ?.classList
        .remove('hidden')


      loginDivider
        ?.classList
        .remove('hidden')


      if (
        loginDescription
      ) {

        loginDescription.textContent =
          'Googleアカウント、またはメールアドレスでご入店ください'
      }
    }


    if (
      panelName ===
      'signup'
    ) {

      signupPanel
        ?.classList
        .remove('hidden')


      if (
        loginDescription
      ) {

        loginDescription.textContent =
          'はじめての方はこちらからご登録ください'
      }


      setTimeout(
        () => {
          signupNickname
            ?.focus()
        },
        0
      )
    }


    if (
      panelName ===
      'forgot'
    ) {

      forgotPanel
        ?.classList
        .remove('hidden')


      if (
        loginDescription
      ) {

        loginDescription.textContent =
          'パスワードを再設定します'
      }
    }


    setMessage('')
  }


  /*
   * =========================
   * 登録成功画面
   * =========================
   */

  function showSignupSuccessScreen(
    email: string
  ) {

    mainArea
      ?.classList
      .add('hidden')


    signupSuccessScreen
      ?.classList
      .remove('hidden')


    if (
      signupSuccessEmail
    ) {

      signupSuccessEmail.textContent =
        email
    }
  }


  /*
   * =========================
   * ニックネーム保存
   * =========================
   */

  async function saveNicknameForUser(
    user: any,
    nickname: string
  ) {

    const cleanName =
      cleanNickname(
        nickname
      )


    if (
      !user ||
      !cleanName
    ) {

      return false
    }


    try {

      const {
        data: existingProfile,
        error: selectError,
      } =
        await supabase
          .from('profiles')
          .select(
            'display_name, memory, name_confirmed'
          )
          .eq(
            'user_id',
            user.id
          )
          .maybeSingle()


      if (
        selectError
      ) {

        console.error(
          'Profile lookup error:',
          selectError
        )
      }


      /*
       * すでに確定したニックネームがある場合は
       * 勝手に変更しない
       */
      if (
        existingProfile
          ?.name_confirmed &&
        existingProfile
          ?.display_name
      ) {

        return true
      }


      const {
        error,
      } =
        await supabase
          .from('profiles')
          .upsert(
            {
              user_id:
                user.id,

              display_name:
                cleanName,

              name_confirmed:
                true,

              memory:
                existingProfile
                  ?.memory || null,

              updated_at:
                new Date()
                  .toISOString(),
            },
            {
              onConflict:
                'user_id',
            }
          )


      if (
        error
      ) {

        console.error(
          'Nickname save error:',
          error
        )

        return false
      }


      return true


    } catch (
      error
    ) {

      console.error(
        'Nickname save exception:',
        error
      )

      return false
    }
  }


  /*
   * =========================
   * Google認証後
   * =========================
   */

  async function applyPendingGoogleNickname(
    user: any
  ) {

    if (!user) {
      return
    }


    const pendingNickname =
      sessionStorage.getItem(
        GOOGLE_NICKNAME_KEY
      )


    if (
      !pendingNickname
    ) {

      return
    }


    const saved =
      await saveNicknameForUser(
        user,
        pendingNickname
      )


    if (
      saved
    ) {

      sessionStorage.removeItem(
        GOOGLE_NICKNAME_KEY
      )
    }
  }


  /*
   * =========================
   * メール認証後
   * =========================
   */

  async function applyPendingEmailNickname(
    user: any
  ) {

    if (!user) {
      return
    }


    const metadataNickname =
      cleanNickname(
        user
          ?.user_metadata
          ?.display_name ||
        user
          ?.user_metadata
          ?.nickname ||
        ''
      )


    const storedNickname =
      cleanNickname(
        localStorage.getItem(
          EMAIL_NICKNAME_KEY
        ) || ''
      )


    const nickname =
      metadataNickname ||
      storedNickname


    if (
      !nickname
    ) {

      return
    }


    const saved =
      await saveNicknameForUser(
        user,
        nickname
      )


    if (
      saved
    ) {

      localStorage.removeItem(
        EMAIL_NICKNAME_KEY
      )
    }
  }


  /*
   * =========================
   * ログイン済み確認
   * =========================
   */

  async function checkCurrentSession() {

    const {
      data: {
        session,
      },
    } =
      await supabase.auth
        .getSession()


    if (
      !session
    ) {

      return
    }


    const user =
      session.user


    await applyPendingGoogleNickname(
      user
    )


    await applyPendingEmailNickname(
      user
    )


    window.location.href =
      '/'
  }


  /*
   * =========================
   * Googleログイン
   * =========================
   */

  googleLoginButton
    ?.addEventListener(
      'click',
      async () => {

        /*
         * 通常ログインなので、
         * 新規登録用ニックネームを消す
         */
        sessionStorage.removeItem(
          GOOGLE_NICKNAME_KEY
        )


        googleLoginButton.disabled =
          true


        setMessage(
          'Googleログインへ移動します…'
        )


        const {
          error,
        } =
          await supabase.auth
            .signInWithOAuth(
              {
                provider:
                  'google',

                options: {

                  redirectTo:
                    `${window.location.origin}/password`,
                },
              }
            )


        if (
          error
        ) {

          console.error(
            'Google login error:',
            error
          )


          googleLoginButton.disabled =
            false


          setMessage(
            'Googleログインを開始できませんでした。',
            'error'
          )
        }
      }
    )


  /*
   * =========================
   * Google新規登録
   * =========================
   */

  googleSignupButton
    ?.addEventListener(
      'click',
      async () => {

        const nickname =
          cleanNickname(
            signupNickname
              ?.value
          )


        if (
          !nickname
        ) {

          setMessage(
            'ニックネームを入力してください。',
            'error'
          )


          signupNickname
            ?.focus()

          return
        }


        if (
          nickname.length >
          30
        ) {

          setMessage(
            'ニックネームは30文字以内で入力してください。',
            'error'
          )

          return
        }


        sessionStorage.setItem(
          GOOGLE_NICKNAME_KEY,
          nickname
        )


        googleSignupButton.disabled =
          true


        setMessage(
          'Google新規登録へ移動します…'
        )


        const {
          error,
        } =
          await supabase.auth
            .signInWithOAuth(
              {
                provider:
                  'google',

                options: {

                  redirectTo:
                    `${window.location.origin}/password`,
                },
              }
            )


        if (
          error
        ) {

          console.error(
            'Google signup error:',
            error
          )


          sessionStorage.removeItem(
            GOOGLE_NICKNAME_KEY
          )


          googleSignupButton.disabled =
            false


          setMessage(
            'Google新規登録を開始できませんでした。',
            'error'
          )
        }
      }
    )


  /*
   * =========================
   * メールログイン
   * =========================
   */

  async function loginWithEmail() {

    const email =
      loginEmail
        ?.value
        ?.trim() || ''


    const password =
      loginPassword
        ?.value || ''


    if (
      !email ||
      !password
    ) {

      setMessage(
        'メールアドレスとパスワードを入力してください。',
        'error'
      )

      return
    }


    if (
      !isValidEmail(
        email
      )
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      return
    }


    if (
      !emailLoginButton
    ) {

      return
    }


    emailLoginButton.disabled =
      true


    emailLoginButton.textContent =
      'ログイン中…'


    try {

      const {
        data,
        error,
      } =
        await supabase.auth
          .signInWithPassword(
            {
              email,
              password,
            }
          )


      if (
        error
      ) {

        console.error(
          'Email login error:',
          error
        )


        setMessage(
          'メールアドレスまたはパスワードを確認してください。メール認証がまだの場合は確認メールもご確認ください。',
          'error'
        )

        return
      }


      if (
        data?.user
      ) {

        await applyPendingEmailNickname(
          data.user
        )
      }


      window.location.href =
        '/'


    } catch (
      error
    ) {

      console.error(
        'Email login exception:',
        error
      )


      setMessage(
        'ログイン中にエラーが発生しました。',
        'error'
      )


    } finally {

      emailLoginButton.disabled =
        false


      emailLoginButton.textContent =
        'ログイン'
    }
  }


  /*
   * =========================
   * メール新規登録
   * =========================
   */

  async function signUpWithEmail() {

    const nickname =
      cleanNickname(
        signupNickname
          ?.value
      )


    const email =
      signupEmail
        ?.value
        ?.trim() || ''


    const password =
      signupPassword
        ?.value || ''


    const passwordConfirm =
      signupPasswordConfirm
        ?.value || ''


    if (
      !nickname ||
      !email ||
      !password ||
      !passwordConfirm
    ) {

      setMessage(
        'ニックネームを含め、すべての項目を入力してください。',
        'error'
      )

      return
    }


    if (
      nickname.length >
      30
    ) {

      setMessage(
        'ニックネームは30文字以内で入力してください。',
        'error'
      )

      return
    }


    if (
      !isValidEmail(
        email
      )
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      return
    }


    if (
      password.length <
      6
    ) {

      setMessage(
        'パスワードは6文字以上で設定してください。',
        'error'
      )

      return
    }


    if (
      password !==
      passwordConfirm
    ) {

      setMessage(
        '確認用のパスワードが一致していません。',
        'error'
      )

      return
    }


    if (
      !signupButton
    ) {

      return
    }


    signupButton.disabled =
      true


    signupButton.textContent =
      '登録中…'


    try {

      localStorage.setItem(
        EMAIL_NICKNAME_KEY,
        nickname
      )


      const {
        data,
        error,
      } =
        await supabase.auth
          .signUp(
            {
              email,
              password,

              options: {

                emailRedirectTo:
                  `${window.location.origin}/password`,

                data: {

                  display_name:
                    nickname,

                  nickname:
                    nickname,
                },
              },
            }
          )


      if (
        error
      ) {

        console.error(
          'Signup error:',
          error
        )


        localStorage.removeItem(
          EMAIL_NICKNAME_KEY
        )


        setMessage(
          error.message
            ? `新規登録できませんでした：${error.message}`
            : '新規登録できませんでした。入力内容をご確認ください。',
          'error'
        )

        return
      }


      /*
       * メール確認不要の場合
       */
      if (
        data?.session &&
        data?.user
      ) {

        await saveNicknameForUser(
          data.user,
          nickname
        )


        localStorage.removeItem(
          EMAIL_NICKNAME_KEY
        )


        window.location.href =
          '/'

        return
      }


      /*
       * メール認証が必要な場合
       */
      showSignupSuccessScreen(
        email
      )


    } catch (
      error
    ) {

      console.error(
        'Signup exception:',
        error
      )


      localStorage.removeItem(
        EMAIL_NICKNAME_KEY
      )


      setMessage(
        '新規登録中にエラーが発生しました。',
        'error'
      )


    } finally {

      signupButton.disabled =
        false


      signupButton.textContent =
        'メールアドレスで新規登録'
    }
  }


  /*
   * =========================
   * パスワード再設定
   * =========================
   */

  async function sendPasswordReset() {

    const email =
      forgotEmail
        ?.value
        ?.trim() || ''


    if (
      !email
    ) {

      setMessage(
        '登録したメールアドレスを入力してください。',
        'error'
      )

      return
    }


    if (
      !isValidEmail(
        email
      )
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      return
    }


    if (
      !forgotButton
    ) {

      return
    }


    forgotButton.disabled =
      true


    forgotButton.textContent =
      '送信中…'


    try {

      const {
        error,
      } =
        await supabase.auth
          .resetPasswordForEmail(
            email,
            {
              redirectTo:
                `${window.location.origin}/reset-password`,
            }
          )


      if (
        error
      ) {

        console.error(
          'Password reset error:',
          error
        )


        setMessage(
          '再設定メールを送信できませんでした。少し時間をおいてお試しください。',
          'error'
        )

        return
      }


      setMessage(
        '該当するアカウントがある場合、パスワード再設定メールをお送りしました。',
        'success'
      )


    } catch (
      error
    ) {

      console.error(
        'Password reset exception:',
        error
      )


      setMessage(
        '再設定処理中にエラーが発生しました。',
        'error'
      )


    } finally {

      forgotButton.disabled =
        false


      forgotButton.textContent =
        '再設定メールを送る'
    }
  }


  /*
   * =========================
   * 画面切替
   * =========================
   */

  showSignupButton
    ?.addEventListener(
      'click',
      () => {

        showPanel(
          'signup'
        )
      }
    )


  showForgotButton
    ?.addEventListener(
      'click',
      () => {

        const email =
          loginEmail
            ?.value
            ?.trim()


        if (
          email &&
          forgotEmail
        ) {

          forgotEmail.value =
            email
        }


        showPanel(
          'forgot'
        )
      }
    )


  backFromSignup
    ?.addEventListener(
      'click',
      () => {

        showPanel(
          'login'
        )
      }
    )


  backFromForgot
    ?.addEventListener(
      'click',
      () => {

        showPanel(
          'login'
        )
      }
    )


  /*
   * =========================
   * ボタン
   * =========================
   */

  emailLoginButton
    ?.addEventListener(
      'click',
      loginWithEmail
    )


  signupButton
    ?.addEventListener(
      'click',
      signUpWithEmail
    )


  forgotButton
    ?.addEventListener(
      'click',
      sendPasswordReset
    )


  /*
   * =========================
   * Enterキー
   * =========================
   */

  loginPassword
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key ===
          'Enter'
        ) {

          event.preventDefault()

          loginWithEmail()
        }
      }
    )


  signupPasswordConfirm
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key ===
          'Enter'
        ) {

          event.preventDefault()

          signUpWithEmail()
        }
      }
    )


  forgotEmail
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key ===
          'Enter'
        ) {

          event.preventDefault()

          sendPasswordReset()
        }
      }
    )


  /*
   * =========================
   * 起動
   * =========================
   */

  checkCurrentSession()
</script>


