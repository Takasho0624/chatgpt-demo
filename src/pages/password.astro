---
import Layout from '../layouts/Layout.astro'
---

<Layout title="けいのBAR ログイン">
  <main class="login-page">
    <div class="login-card">
      <div class="login-title">けいのBARへようこそ</div>

      <div class="login-text">
        Googleアカウントでログインしてください
      </div>

      <button id="google-login" class="google-button">
        <svg
          class="google-logo"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill="#4285F4"
            d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.33 2.98-7.38Z"
          />
          <path
            fill="#34A853"
            d="M12 22c2.7 0 4.97-.9 6.63-2.39l-3.24-2.51c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.59A10 10 0 0 0 12 22Z"
          />
          <path
            fill="#FBBC05"
            d="M6.39 13.93A6.02 6.02 0 0 1 6.08 12c0-.67.11-1.32.31-1.93V7.48H3.04A10 10 0 0 0 2 12c0 1.61.39 3.13 1.04 4.52l3.35-2.59Z"
          />
          <path
            fill="#EA4335"
            d="M12 5.94c1.47 0 2.78.51 3.82 1.5l2.87-2.87C16.96 2.96 14.7 2 12 2a10 10 0 0 0-8.96 5.48l3.35 2.59C7.18 7.7 9.39 5.94 12 5.94Z"
          />
        </svg>

        <span>Googleでログイン</span>
      </button>

      <div class="login-note">
        ログインすると、会話履歴をあなた専用に保存できます
      </div>
    </div>
  </main>
</Layout>

<script>
import { supabase } from '../utils/supabase'

const loginButton = document.getElementById('google-login')

loginButton?.addEventListener('click', async () => {
  await supabase.auth.signInWithOAuth({
    provider: 'google',
    options: {
      redirectTo: window.location.origin,
    },
  })
})
</script>

<style>
.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.login-card {
  width: min(420px, 90vw);
  padding: 34px;
  border-radius: 18px;
  background: rgba(22, 13, 8, 0.80);
  border: 1px solid rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(12px);
  text-align: center;
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.4);
}

.login-title {
  font-size: 26px;
  font-weight: 700;
  color: white;
  margin-bottom: 10px;
}

.login-text {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.72);
  margin-bottom: 24px;
}

.google-button {
  width: 100%;
  height: 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border: 1px solid #dadce0;
  border-radius: 10px;
  background: #fff;
  color: #202124;
  font-size: 16px;
  font-weight: 500;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.google-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
}

.google-logo {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
}

.login-note {
  margin-top: 18px;
  font-size: 12px;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.5);
}
</style>
