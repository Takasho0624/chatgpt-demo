---
import Layout from '../layouts/Layout.astro'
---

<Layout title="けいのBAR ログイン">
  <main class="login-page">

    <div class="login-card">

      <div class="login-title">
        けいのBARへようこそ
      </div>

      <div class="login-text">
        Googleまたはメールアドレスでログインしてください
      </div>


      <!-- =========================
           Googleログイン
           ========================= -->

      <button
        id="google-login"
        class="google-button"
        type="button"
      >
        <svg
          class="google-logo"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill="#4285F4"
            d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.33 2.98-7.38Z"
          />
          <path
            fill="#34A853"
            d="M12 22c2.7 0 4.97-.9 6.63-2.39l-3.24-2.51c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.59A10 10 0 0 0 12 22Z"
          />
          <path
            fill="#FBBC05"
            d="M6.39 13.93A6.02 6.02 0 0 1 6.08 12c0-.67.11-1.32.31-1.93V7.48H3.04A10 10 0 0 0 2 12c0 1.61.39 3.13 1.04 4.52l3.35-2.59Z"
          />
          <path
            fill="#EA4335"
            d="M12 5.94c1.47 0 2.78.51 3.82 1.5l2.87-2.87C16.96 2.96 14.7 2 12 2a10 10 0 0 0-8.96 5.48l3.35 2.59C7.18 7.7 9.39 5.94 12 5.94Z"
          />
        </svg>

        <span>
          Googleでログイン
        </span>
      </button>


      <!-- =========================
           区切り線
           ========================= -->

      <div class="divider">

        <span></span>

        <div>
          または
        </div>

        <span></span>

      </div>


      <!-- =========================
           メールログイン
           ========================= -->

      <div class="email-area">

        <label
          for="email-input"
          class="email-label"
        >
          メールアドレス
        </label>

        <input
          id="email-input"
          class="email-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="example@example.com"
        />

        <button
          id="email-login"
          class="email-button"
          type="button"
        >
          ログインリンクを送る
        </button>

      </div>


      <!-- =========================
           状態表示
           ========================= -->

      <div
        id="login-message"
        class="login-message"
      ></div>


      <div class="login-note">
        メールログインでは、届いたメールのリンクを押すだけでログインできます。
        パスワードを作る必要はありません。
      </div>

    </div>

  </main>
</Layout>


<script>
  import { supabase } from '../utils/supabase'


  /*
   * =========================
   * DOM
   * =========================
   */

  const googleLoginButton =
    document.getElementById(
      'google-login'
    )


  const emailLoginButton =
    document.getElementById(
      'email-login'
    )


  const emailInput =
    document.getElementById(
      'email-input'
    )


  const loginMessage =
    document.getElementById(
      'login-message'
    )


  /*
   * =========================
   * メッセージ表示
   * =========================
   */

  function setMessage(
    text = '',
    type = ''
  ) {

    if (!loginMessage) {
      return
    }


    loginMessage.textContent =
      text


    loginMessage.classList.remove(
      'success',
      'error'
    )


    if (type) {

      loginMessage.classList.add(
        type
      )
    }
  }


  /*
   * =========================
   * すでにログイン済みなら
   * TOPへ
   * =========================
   */

  async function checkCurrentSession() {

    const {
      data: {
        session,
      },
    } =
      await supabase.auth
        .getSession()


    if (session) {

      window.location.href =
        '/'
    }
  }


  /*
   * =========================
   * Googleログイン
   * =========================
   */

  googleLoginButton
    ?.addEventListener(
      'click',
      async () => {

        setMessage(
          'Googleログインへ移動します…'
        )


        const {
          error,
        } =
          await supabase.auth
            .signInWithOAuth({
              provider:
                'google',

              options: {
                redirectTo:
                  window.location.origin,
              },
            })


        if (error) {

          console.error(
            'Google login error:',
            error
          )


          setMessage(
            'Googleログインを開始できませんでした。',
            'error'
          )
        }
      }
    )


  /*
   * =========================
   * メールログイン
   * =========================
   */

  async function sendMagicLink() {

    const email =
      emailInput
        ?.value
        ?.trim()


    if (!email) {

      setMessage(
        'メールアドレスを入力してください。',
        'error'
      )

      emailInput
        ?.focus()

      return
    }


    /*
     * 簡単なメール形式チェック
     */
    if (
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/
        .test(email)
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      emailInput
        ?.focus()

      return
    }


    if (
      emailLoginButton
    ) {

      emailLoginButton.disabled =
        true

      emailLoginButton.textContent =
        '送信中…'
    }


    setMessage(
      'ログインメールを送っています…'
    )


    try {

      const {
        error,
      } =
        await supabase.auth
          .signInWithOtp({

            email,

            options: {

              /*
               * メール内リンクを押した後、
               * けいのBARのTOPへ戻る
               */
              emailRedirectTo:
                `${window.location.origin}/`,
            },
          })


      if (error) {

        console.error(
          'Email login error:',
          error
        )


        setMessage(
          'メールを送信できませんでした。少し時間をおいて、もう一度試してください。',
          'error'
        )

        return
      }


      setMessage(
        'ログイン用のメールを送りました。メールを開いて、ログインリンクを押してください🍸',
        'success'
      )


    } catch (
      error
    ) {

      console.error(
        'Email login exception:',
        error
      )


      setMessage(
        'メール送信中にエラーが発生しました。',
        'error'
      )


    } finally {

      if (
        emailLoginButton
      ) {

        emailLoginButton.disabled =
          false

        emailLoginButton.textContent =
          'ログインリンクを送る'
      }
    }
  }


  emailLoginButton
    ?.addEventListener(
      'click',
      sendMagicLink
    )


  /*
   * Enterでも送信
   */

  emailInput
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key ===
          'Enter'
        ) {

          event.preventDefault()

          sendMagicLink()
        }
      }
    )


  /*
   * =========================
   * 起動
   * =========================
   */

  checkCurrentSession()
</script>


<style>

.login-page {

  min-height:
    100vh;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  padding:
    24px;
}


.login-card {

  width:
    min(
      420px,
      90vw
    );

  padding:
    34px;

  border-radius:
    18px;

  background:
    rgba(
      22,
      13,
      8,
      0.80
    );

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      0.16
    );

  backdrop-filter:
    blur(12px);

  text-align:
    center;

  box-shadow:
    0
    18px
    50px
    rgba(
      0,
      0,
      0,
      0.4
    );
}


.login-title {

  font-size:
    26px;

  font-weight:
    700;

  color:
    white;

  margin-bottom:
    10px;
}


.login-text {

  font-size:
    14px;

  color:
    rgba(
      255,
      255,
      255,
      0.72
    );

  margin-bottom:
    24px;
}


/* =========================
   Google
   ========================= */

.google-button {

  width:
    100%;

  height:
    54px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    12px;

  border:
    1px solid
    #dadce0;

  border-radius:
    10px;

  background:
    #fff;

  color:
    #202124;

  font-size:
    16px;

  font-weight:
    500;

  cursor:
    pointer;

  transition:
    transform 0.15s ease,
    box-shadow 0.15s ease;
}


.google-button:hover {

  transform:
    translateY(-1px);

  box-shadow:
    0
    6px
    18px
    rgba(
      0,
      0,
      0,
      0.22
    );
}


.google-logo {

  width:
    22px;

  height:
    22px;

  flex-shrink:
    0;
}


/* =========================
   区切り
   ========================= */

.divider {

  display:
    flex;

  align-items:
    center;

  gap:
    12px;

  margin:
    24px 0;

  color:
    rgba(
      255,
      255,
      255,
      .40
    );

  font-size:
    12px;
}


.divider span {

  flex:
    1;

  height:
    1px;

  background:
    rgba(
      255,
      255,
      255,
      .14
    );
}


/* =========================
   メール
   ========================= */

.email-area {

  text-align:
    left;
}


.email-label {

  display:
    block;

  margin-bottom:
    8px;

  color:
    rgba(
      255,
      255,
      255,
      .72
    );

  font-size:
    13px;
}


.email-input {

  width:
    100%;

  height:
    52px;

  padding:
    0 14px;

  box-sizing:
    border-box;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      .20
    );

  border-radius:
    10px;

  outline:
    none;

  background:
    rgba(
      255,
      255,
      255,
      .08
    );

  color:
    #fff;

  font-size:
    16px;

  transition:
    border-color .15s ease,
    background .15s ease;
}


.email-input::placeholder {

  color:
    rgba(
      255,
      255,
      255,
      .30
    );
}


.email-input:focus {

  border-color:
    rgba(
      255,
      255,
      255,
      .48
    );

  background:
    rgba(
      255,
      255,
      255,
      .11
    );
}


.email-button {

  width:
    100%;

  height:
    52px;

  margin-top:
    12px;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      .20
    );

  border-radius:
    10px;

  background:
    rgba(
      255,
      255,
      255,
      .12
    );

  color:
    #fff;

  font-size:
    15px;

  font-weight:
    600;

  cursor:
    pointer;

  transition:
    background .15s ease,
    transform .15s ease;
}


.email-button:hover {

  background:
    rgba(
      255,
      255,
      255,
      .18
    );

  transform:
    translateY(-1px);
}


.email-button:disabled {

  opacity:
    .45;

  cursor:
    default;

  transform:
    none;
}


/* =========================
   状態
   ========================= */

.login-message {

  min-height:
    20px;

  margin-top:
    18px;

  font-size:
    13px;

  line-height:
    1.6;

  color:
    rgba(
      255,
      255,
      255,
      .65
    );
}


.login-message.success {

  color:
    #b9f6ca;
}


.login-message.error {

  color:
    #ffb4ab;
}


.login-note {

  margin-top:
    16px;

  font-size:
    12px;

  line-height:
    1.7;

  color:
    rgba(
      255,
      255,
      255,
      0.5
    );
}


/* =========================
   スマホ
   ========================= */

@media (
  max-width: 640px
) {

  .login-page {

    padding:
      16px;
  }


  .login-card {

    width:
      100%;

    padding:
      28px 20px;
  }


  .login-title {

    font-size:
      23px;
  }

}

</style>
