---
import Layout from '../layouts/Layout.astro'
---

<Layout title="けいのBAR ログイン">
  <main class="login-page">

    <div class="login-card">

      <div class="login-title">
        けいのBARへようこそ
      </div>

      <div class="login-text">
        Googleアカウント、またはメールアドレスでご入店ください
      </div>


      <!-- =========================
           Googleログイン
           ========================= -->

      <div class="google-area">

        <label
          for="google-nickname"
          class="field-label"
        >
          はじめての方はニックネームを入力してください
        </label>

        <input
          id="google-nickname"
          class="field-input"
          type="text"
          autocomplete="nickname"
          maxlength="30"
          placeholder="例：ショウくん"
        />

        <div class="nickname-note">
          すでにご利用中の方は空欄のままGoogleログインできます
        </div>

        <button
          id="google-login"
          class="google-button"
          type="button"
        >
          <svg
            class="google-logo"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill="#4285F4"
              d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.33 2.98-7.38Z"
            />
            <path
              fill="#34A853"
              d="M12 22c2.7 0 4.97-.9 6.63-2.39l-3.24-2.51c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.59A10 10 0 0 0 12 22Z"
            />
            <path
              fill="#FBBC05"
              d="M6.39 13.93A6.02 6.02 0 0 1 6.08 12c0-.67.11-1.32.31-1.93V7.48H3.04A10 10 0 0 0 2 12c0 1.61.39 3.13 1.04 4.52l3.35-2.59Z"
            />
            <path
              fill="#EA4335"
              d="M12 5.94c1.47 0 2.78.51 3.82 1.5l2.87-2.87C16.96 2.96 14.7 2 12 2a10 10 0 0 0-8.96 5.48l3.35 2.59C7.18 7.7 9.39 5.94 12 5.94Z"
            />
          </svg>

          <span>
            Googleでログイン
          </span>
        </button>

      </div>


      <!-- =========================
           区切り
           ========================= -->

      <div class="divider">

        <span></span>

        <div>
          または
        </div>

        <span></span>

      </div>


      <!-- =========================
           メールログイン
           ========================= -->

      <div
        id="login-panel"
        class="auth-panel"
      >

        <div class="panel-title">
          メールアドレスでログイン
        </div>


        <label
          for="login-email"
          class="field-label"
        >
          メールアドレス
        </label>

        <input
          id="login-email"
          class="field-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="example@example.com"
        />


        <label
          for="login-password"
          class="field-label password-label"
        >
          パスワード
        </label>

        <input
          id="login-password"
          class="field-input"
          type="password"
          autocomplete="current-password"
          placeholder="パスワード"
        />


        <button
          id="email-login"
          class="primary-button"
          type="button"
        >
          ログイン
        </button>


        <button
          id="show-forgot"
          class="text-button"
          type="button"
        >
          パスワードを忘れた方
        </button>


        <div class="new-user-area">

          <span>
            はじめての方は
          </span>

          <button
            id="show-signup"
            class="inline-button"
            type="button"
          >
            新規登録
          </button>

        </div>

      </div>


      <!-- =========================
           新規登録
           ========================= -->

      <div
        id="signup-panel"
        class="auth-panel hidden"
      >

        <div class="panel-title">
          はじめての方
        </div>

        <div class="panel-description">
          ニックネーム、メールアドレス、パスワードを登録してください。
          けいは最初からこのニックネームでお呼びします。
        </div>


        <label
          for="signup-nickname"
          class="field-label"
        >
          ニックネーム
        </label>

        <input
          id="signup-nickname"
          class="field-input"
          type="text"
          autocomplete="nickname"
          maxlength="30"
          placeholder="例：ショウくん"
        />


        <label
          for="signup-email"
          class="field-label password-label"
        >
          メールアドレス
        </label>

        <input
          id="signup-email"
          class="field-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="example@example.com"
        />


        <label
          for="signup-password"
          class="field-label password-label"
        >
          パスワード
        </label>

        <input
          id="signup-password"
          class="field-input"
          type="password"
          autocomplete="new-password"
          placeholder="6文字以上のパスワード"
        />


        <label
          for="signup-password-confirm"
          class="field-label password-label"
        >
          パスワード確認
        </label>

        <input
          id="signup-password-confirm"
          class="field-input"
          type="password"
          autocomplete="new-password"
          placeholder="もう一度入力してください"
        />


        <button
          id="signup-button"
          class="primary-button"
          type="button"
        >
          新規登録
        </button>


        <button
          id="back-from-signup"
          class="text-button"
          type="button"
        >
          ← ログイン画面へ戻る
        </button>

      </div>


      <!-- =========================
           パスワード再設定
           ========================= -->

      <div
        id="forgot-panel"
        class="auth-panel hidden"
      >

        <div class="panel-title">
          パスワード再設定
        </div>

        <div class="panel-description">
          登録したメールアドレスを入力してください。
          新しいパスワードを設定するためのメールを送ります。
        </div>


        <label
          for="forgot-email"
          class="field-label"
        >
          メールアドレス
        </label>

        <input
          id="forgot-email"
          class="field-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="example@example.com"
        />


        <button
          id="forgot-button"
          class="primary-button"
          type="button"
        >
          再設定メールを送る
        </button>


        <button
          id="back-from-forgot"
          class="text-button"
          type="button"
        >
          ← ログイン画面へ戻る
        </button>

      </div>


      <!-- =========================
           メッセージ
           ========================= -->

      <div
        id="auth-message"
        class="auth-message"
      ></div>


      <div class="login-note">
        ご登録いただいたニックネーム、会話履歴、記憶は、
        ログインしたアカウントごとに保存されます。
      </div>

    </div>

  </main>
</Layout>


<script>
  import { supabase } from '../utils/supabase'


  /*
   * =========================
   * 定数
   * =========================
   */

  const GOOGLE_NICKNAME_KEY =
    'kei_bar_pending_google_nickname'

  const EMAIL_NICKNAME_KEY =
    'kei_bar_pending_email_nickname'


  /*
   * =========================
   * DOM
   * =========================
   */

  const googleLoginButton =
    document.getElementById(
      'google-login'
    )


  const googleNickname =
    document.getElementById(
      'google-nickname'
    )


  const loginPanel =
    document.getElementById(
      'login-panel'
    )


  const signupPanel =
    document.getElementById(
      'signup-panel'
    )


  const forgotPanel =
    document.getElementById(
      'forgot-panel'
    )


  const loginEmail =
    document.getElementById(
      'login-email'
    )


  const loginPassword =
    document.getElementById(
      'login-password'
    )


  const emailLoginButton =
    document.getElementById(
      'email-login'
    )


  const showSignupButton =
    document.getElementById(
      'show-signup'
    )


  const showForgotButton =
    document.getElementById(
      'show-forgot'
    )


  const signupNickname =
    document.getElementById(
      'signup-nickname'
    )


  const signupEmail =
    document.getElementById(
      'signup-email'
    )


  const signupPassword =
    document.getElementById(
      'signup-password'
    )


  const signupPasswordConfirm =
    document.getElementById(
      'signup-password-confirm'
    )


  const signupButton =
    document.getElementById(
      'signup-button'
    )


  const forgotEmail =
    document.getElementById(
      'forgot-email'
    )


  const forgotButton =
    document.getElementById(
      'forgot-button'
    )


  const backFromSignup =
    document.getElementById(
      'back-from-signup'
    )


  const backFromForgot =
    document.getElementById(
      'back-from-forgot'
    )


  const authMessage =
    document.getElementById(
      'auth-message'
    )


  /*
   * =========================
   * 共通
   * =========================
   */

  function setMessage(
    text = '',
    type = ''
  ) {

    if (!authMessage) {
      return
    }


    authMessage.textContent =
      text


    authMessage.classList.remove(
      'success',
      'error'
    )


    if (type) {

      authMessage.classList.add(
        type
      )
    }
  }


  function isValidEmail(
    email
  ) {

    return (
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/
        .test(email)
    )
  }


  function cleanNickname(
    nickname
  ) {

    return (
      nickname
        ?.replace(
          /^[「『"'“”]+/,
          ''
        )
        ?.replace(
          /[」』"'“”]+$/,
          ''
        )
        ?.trim() || ''
    )
  }


  function showPanel(
    panelName
  ) {

    loginPanel
      ?.classList
      .add('hidden')


    signupPanel
      ?.classList
      .add('hidden')


    forgotPanel
      ?.classList
      .add('hidden')


    if (
      panelName === 'login'
    ) {

      loginPanel
        ?.classList
        .remove('hidden')
    }


    if (
      panelName === 'signup'
    ) {

      signupPanel
        ?.classList
        .remove('hidden')
    }


    if (
      panelName === 'forgot'
    ) {

      forgotPanel
        ?.classList
        .remove('hidden')
    }


    setMessage('')
  }


  /*
   * =========================
   * ニックネーム保存
   * =========================
   */

  async function saveNicknameForUser(
    user,
    nickname
  ) {

    const cleanName =
      cleanNickname(
        nickname
      )


    if (
      !user ||
      !cleanName
    ) {

      return false
    }


    try {

      /*
       * 既存プロフィールを確認。
       * すでに確定済みの名前がある場合は
       * ログイン時に勝手に上書きしない。
       */
      const {
        data: existingProfile,
        error: selectError,
      } =
        await supabase
          .from('profiles')
          .select(
            'display_name, memory, name_confirmed'
          )
          .eq(
            'user_id',
            user.id
          )
          .maybeSingle()


      if (selectError) {

        console.error(
          'Profile lookup error:',
          selectError
        )
      }


      if (
        existingProfile
          ?.name_confirmed &&
        existingProfile
          ?.display_name
    ) {

        return true
      }


      const {
        error,
      } =
        await supabase
          .from('profiles')
          .upsert({

            user_id:
              user.id,

            display_name:
              cleanName,

            name_confirmed:
              true,

            memory:
              existingProfile
                ?.memory || null,

            updated_at:
              new Date()
                .toISOString(),
          })


      if (error) {

        console.error(
          'Nickname save error:',
          error
        )

        return false
      }


      return true


    } catch (
      error
    ) {

      console.error(
        'Nickname save exception:',
        error
      )

      return false
    }
  }


  /*
   * =========================
   * Googleログインから
   * 戻ってきた時の
   * ニックネーム確定
   * =========================
   */

  async function applyPendingGoogleNickname(
    user
  ) {

    if (!user) {
      return
    }


    const pendingNickname =
      sessionStorage.getItem(
        GOOGLE_NICKNAME_KEY
      )


    if (!pendingNickname) {
      return
    }


    const saved =
      await saveNicknameForUser(
        user,
        pendingNickname
      )


    if (saved) {

      sessionStorage.removeItem(
        GOOGLE_NICKNAME_KEY
      )
    }
  }


  /*
   * =========================
   * メール認証から
   * 戻ってきた時の
   * ニックネーム確定
   * =========================
   */

  async function applyPendingEmailNickname(
    user
  ) {

    if (!user) {
      return
    }


    const pendingNickname =
      localStorage.getItem(
        EMAIL_NICKNAME_KEY
      )


    if (!pendingNickname) {
      return
    }


    const saved =
      await saveNicknameForUser(
        user,
        pendingNickname
      )


    if (saved) {

      localStorage.removeItem(
        EMAIL_NICKNAME_KEY
      )
    }
  }


  /*
   * =========================
   * すでにログイン済みなら
   * ニックネーム処理後TOPへ
   * =========================
   */

  async function checkCurrentSession() {

    const {
      data: {
        session,
      },
    } =
      await supabase.auth
        .getSession()


    if (!session) {
      return
    }


    const user =
      session.user


    await applyPendingGoogleNickname(
      user
    )


    await applyPendingEmailNickname(
      user
    )


    window.location.href =
      '/'
  }


  /*
   * =========================
   * Googleログイン
   * =========================
   */

  googleLoginButton
    ?.addEventListener(
      'click',
      async () => {

        const nickname =
          cleanNickname(
            googleNickname
              ?.value
          )


        /*
         * ニックネームが入力されていたら
         * Googleから戻るまで一時保存。
         *
         * 既存ユーザーは空欄でOK。
         */
        if (nickname) {

          sessionStorage.setItem(
            GOOGLE_NICKNAME_KEY,
            nickname
          )

        } else {

          sessionStorage.removeItem(
            GOOGLE_NICKNAME_KEY
          )
        }


        setMessage(
          'Googleログインへ移動します…'
        )


        const {
          error,
        } =
          await supabase.auth
            .signInWithOAuth({
              provider:
                'google',

              options: {

                /*
                 * passwordページへ戻す。
                 *
                 * 戻った直後に
                 * pending nicknameを
                 * profilesへ保存してからTOPへ進む。
                 */
                redirectTo:
                  `${window.location.origin}/password`,
              },
            })


        if (error) {

          console.error(
            'Google login error:',
            error
          )


          setMessage(
            'Googleログインを開始できませんでした。',
            'error'
          )
        }
      }
    )


  /*
   * =========================
   * メール＋パスワードログイン
   * =========================
   */

  async function loginWithEmail() {

    const email =
      loginEmail
        ?.value
        ?.trim() || ''


    const password =
      loginPassword
        ?.value || ''


    if (
      !email ||
      !password
    ) {

      setMessage(
        'メールアドレスとパスワードを入力してください。',
        'error'
      )

      return
    }


    if (
      !isValidEmail(email)
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      return
    }


    emailLoginButton.disabled =
      true


    emailLoginButton.textContent =
      'ログイン中…'


    try {

      const {
        data,
        error,
      } =
        await supabase.auth
          .signInWithPassword({
            email,
            password,
          })


      if (error) {

        console.error(
          'Email login error:',
          error
        )


        setMessage(
          'メールアドレスまたはパスワードを確認してください。メール認証がまだの場合は、確認メールもご確認ください。',
          'error'
        )

        return
      }


      if (
        data?.user
      ) {

        /*
         * メール認証完了時に
         * nicknameが未保存だった場合の
         * 保険
         */
        await applyPendingEmailNickname(
          data.user
        )
      }


      window.location.href =
        '/'


    } catch (
      error
    ) {

      console.error(
        'Email login exception:',
        error
      )


      setMessage(
        'ログイン中にエラーが発生しました。',
        'error'
      )


    } finally {

      emailLoginButton.disabled =
        false


      emailLoginButton.textContent =
        'ログイン'
    }
  }


  /*
   * =========================
   * 新規登録
   * =========================
   */

  async function signUpWithEmail() {

    const nickname =
      cleanNickname(
        signupNickname
          ?.value
      )


    const email =
      signupEmail
        ?.value
        ?.trim() || ''


    const password =
      signupPassword
        ?.value || ''


    const passwordConfirm =
      signupPasswordConfirm
        ?.value || ''


    if (
      !nickname ||
      !email ||
      !password ||
      !passwordConfirm
    ) {

      setMessage(
        'ニックネームを含め、すべての項目を入力してください。',
        'error'
      )

      return
    }


    if (
      nickname.length > 30
    ) {

      setMessage(
        'ニックネームは30文字以内で入力してください。',
        'error'
      )

      return
    }


    if (
      !isValidEmail(email)
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      return
    }


    if (
      password.length < 6
    ) {

      setMessage(
        'パスワードは6文字以上で設定してください。',
        'error'
      )

      return
    }


    if (
      password !==
      passwordConfirm
    ) {

      setMessage(
        '確認用のパスワードが一致していません。',
        'error'
      )

      return
    }


    signupButton.disabled =
      true


    signupButton.textContent =
      '登録中…'


    try {

      /*
       * メール認証を挟む場合、
       * 認証が完了するまで
       * profilesへ直接書き込めないため、
       * 一時保存しておく。
       */
      localStorage.setItem(
        EMAIL_NICKNAME_KEY,
        nickname
      )


      const {
        data,
        error,
      } =
        await supabase.auth
          .signUp({
            email,
            password,

            options: {

              /*
               * メール確認後は
               * passwordページへ戻す。
               *
               * そこでnicknameを
               * profilesへ保存してから
               * TOPへ進む。
               */
              emailRedirectTo:
                `${window.location.origin}/password`,
            },
          })


      if (error) {

        console.error(
          'Signup error:',
          error
        )


        localStorage.removeItem(
          EMAIL_NICKNAME_KEY
        )


        setMessage(
          '新規登録できませんでした。入力内容をご確認ください。',
          'error'
        )

        return
      }


      /*
       * メール確認が無効などで
       * その場でsessionが作られた場合
       */
      if (
        data?.session &&
        data?.user
      ) {

        await saveNicknameForUser(
          data.user,
          nickname
        )


        localStorage.removeItem(
          EMAIL_NICKNAME_KEY
        )


        window.location.href =
          '/'

        return
      }


      setMessage(
        '登録確認メールを送りました🍸 メール内の「けいのBARへ入店する」を押して登録を完了してください。',
        'success'
      )


    } catch (
      error
    ) {

      console.error(
        'Signup exception:',
        error
      )


      localStorage.removeItem(
        EMAIL_NICKNAME_KEY
      )


      setMessage(
        '新規登録中にエラーが発生しました。',
        'error'
      )


    } finally {

      signupButton.disabled =
        false


      signupButton.textContent =
        '新規登録'
    }
  }


  /*
   * =========================
   * パスワード再設定メール
   * =========================
   */

  async function sendPasswordReset() {

    const email =
      forgotEmail
        ?.value
        ?.trim() || ''


    if (!email) {

      setMessage(
        '登録したメールアドレスを入力してください。',
        'error'
      )

      return
    }


    if (
      !isValidEmail(email)
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      return
    }


    forgotButton.disabled =
      true


    forgotButton.textContent =
      '送信中…'


    try {

      const {
        error,
      } =
        await supabase.auth
          .resetPasswordForEmail(
            email,
            {
              redirectTo:
                `${window.location.origin}/reset-password`,
            }
          )


      if (error) {

        console.error(
          'Password reset error:',
          error
        )


        setMessage(
          '再設定メールを送信できませんでした。少し時間をおいてお試しください。',
          'error'
        )

        return
      }


      setMessage(
        '該当するアカウントがある場合、パスワード再設定メールをお送りしました。',
        'success'
      )


    } catch (
      error
    ) {

      console.error(
        'Password reset exception:',
        error
      )


      setMessage(
        '再設定処理中にエラーが発生しました。',
        'error'
      )


    } finally {

      forgotButton.disabled =
        false


      forgotButton.textContent =
        '再設定メールを送る'
    }
  }


  /*
   * =========================
   * 画面切替
   * =========================
   */

  showSignupButton
    ?.addEventListener(
      'click',
      () => {

        showPanel(
          'signup'
        )
      }
    )


  showForgotButton
    ?.addEventListener(
      'click',
      () => {

        const email =
          loginEmail
            ?.value
            ?.trim()


        if (
          email &&
          forgotEmail
        ) {

          forgotEmail.value =
            email
        }


        showPanel(
          'forgot'
        )
      }
    )


  backFromSignup
    ?.addEventListener(
      'click',
      () => {

        showPanel(
          'login'
        )
      }
    )


  backFromForgot
    ?.addEventListener(
      'click',
      () => {

        showPanel(
          'login'
        )
      }
    )


  /*
   * =========================
   * ボタン
   * =========================
   */

  emailLoginButton
    ?.addEventListener(
      'click',
      loginWithEmail
    )


  signupButton
    ?.addEventListener(
      'click',
      signUpWithEmail
    )


  forgotButton
    ?.addEventListener(
      'click',
      sendPasswordReset
    )


  /*
   * =========================
   * Enter送信
   * =========================
   */

  loginPassword
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key === 'Enter'
        ) {

          event.preventDefault()

          loginWithEmail()
        }
      }
    )


  signupPasswordConfirm
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key === 'Enter'
        ) {

          event.preventDefault()

          signUpWithEmail()
        }
      }
    )


  forgotEmail
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key === 'Enter'
        ) {

          event.preventDefault()

          sendPasswordReset()
        }
      }
    )


  /*
   * =========================
   * 起動
   * =========================
   */

  checkCurrentSession()
</script>


