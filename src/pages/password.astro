---
import Layout from '../layouts/Layout.astro'
---

<Layout title="けいのBAR ログイン">
  <main class="login-page">

    <div class="login-card">

      <div class="login-title">
        けいのBARへようこそ
      </div>

      <div class="login-text">
        Googleアカウント、またはメールアドレスでご入店ください
      </div>


      <!-- =========================
           Googleログイン
           ========================= -->

      <button
        id="google-login"
        class="google-button"
        type="button"
      >
        <svg
          class="google-logo"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            fill="#4285F4"
            d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.51h3.24c1.9-1.75 2.98-4.33 2.98-7.38Z"
          />
          <path
            fill="#34A853"
            d="M12 22c2.7 0 4.97-.9 6.63-2.39l-3.24-2.51c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.59A10 10 0 0 0 12 22Z"
          />
          <path
            fill="#FBBC05"
            d="M6.39 13.93A6.02 6.02 0 0 1 6.08 12c0-.67.11-1.32.31-1.93V7.48H3.04A10 10 0 0 0 2 12c0 1.61.39 3.13 1.04 4.52l3.35-2.59Z"
          />
          <path
            fill="#EA4335"
            d="M12 5.94c1.47 0 2.78.51 3.82 1.5l2.87-2.87C16.96 2.96 14.7 2 12 2a10 10 0 0 0-8.96 5.48l3.35 2.59C7.18 7.7 9.39 5.94 12 5.94Z"
          />
        </svg>

        <span>
          Googleでログイン
        </span>
      </button>


      <!-- =========================
           区切り
           ========================= -->

      <div class="divider">

        <span></span>

        <div>
          または
        </div>

        <span></span>

      </div>


      <!-- =========================
           メールログイン
           ========================= -->

      <div
        id="login-panel"
        class="auth-panel"
      >

        <div class="panel-title">
          メールアドレスでログイン
        </div>


        <label
          for="login-email"
          class="field-label"
        >
          メールアドレス
        </label>

        <input
          id="login-email"
          class="field-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="example@example.com"
        />


        <label
          for="login-password"
          class="field-label password-label"
        >
          パスワード
        </label>

        <input
          id="login-password"
          class="field-input"
          type="password"
          autocomplete="current-password"
          placeholder="パスワード"
        />


        <button
          id="email-login"
          class="primary-button"
          type="button"
        >
          ログイン
        </button>


        <button
          id="show-forgot"
          class="text-button"
          type="button"
        >
          パスワードを忘れた方
        </button>


        <div class="new-user-area">

          <span>
            はじめての方は
          </span>

          <button
            id="show-signup"
            class="inline-button"
            type="button"
          >
            新規登録
          </button>

        </div>

      </div>


      <!-- =========================
           新規登録
           ========================= -->

      <div
        id="signup-panel"
        class="auth-panel hidden"
      >

        <div class="panel-title">
          はじめての方
        </div>

        <div class="panel-description">
          メールアドレスとパスワードを登録すると、
          次回から同じ情報でログインできます。
        </div>


        <label
          for="signup-email"
          class="field-label"
        >
          メールアドレス
        </label>

        <input
          id="signup-email"
          class="field-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="example@example.com"
        />


        <label
          for="signup-password"
          class="field-label password-label"
        >
          パスワード
        </label>

        <input
          id="signup-password"
          class="field-input"
          type="password"
          autocomplete="new-password"
          placeholder="6文字以上のパスワード"
        />


        <label
          for="signup-password-confirm"
          class="field-label password-label"
        >
          パスワード確認
        </label>

        <input
          id="signup-password-confirm"
          class="field-input"
          type="password"
          autocomplete="new-password"
          placeholder="もう一度入力してください"
        />


        <button
          id="signup-button"
          class="primary-button"
          type="button"
        >
          新規登録
        </button>


        <button
          id="back-from-signup"
          class="text-button"
          type="button"
        >
          ← ログイン画面へ戻る
        </button>

      </div>


      <!-- =========================
           パスワード再設定
           ========================= -->

      <div
        id="forgot-panel"
        class="auth-panel hidden"
      >

        <div class="panel-title">
          パスワード再設定
        </div>

        <div class="panel-description">
          登録したメールアドレスを入力してください。
          新しいパスワードを設定するためのメールを送ります。
        </div>


        <label
          for="forgot-email"
          class="field-label"
        >
          メールアドレス
        </label>

        <input
          id="forgot-email"
          class="field-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="example@example.com"
        />


        <button
          id="forgot-button"
          class="primary-button"
          type="button"
        >
          再設定メールを送る
        </button>


        <button
          id="back-from-forgot"
          class="text-button"
          type="button"
        >
          ← ログイン画面へ戻る
        </button>

      </div>


      <!-- =========================
           メッセージ
           ========================= -->

      <div
        id="auth-message"
        class="auth-message"
      ></div>


      <div class="login-note">
        ご登録いただいた会話履歴や呼び名は、
        ログインしたアカウントごとに保存されます。
      </div>

    </div>

  </main>
</Layout>


<script>
  import { supabase } from '../utils/supabase'


  /*
   * =========================
   * DOM
   * =========================
   */

  const googleLoginButton =
    document.getElementById(
      'google-login'
    )


  const loginPanel =
    document.getElementById(
      'login-panel'
    )


  const signupPanel =
    document.getElementById(
      'signup-panel'
    )


  const forgotPanel =
    document.getElementById(
      'forgot-panel'
    )


  const loginEmail =
    document.getElementById(
      'login-email'
    )


  const loginPassword =
    document.getElementById(
      'login-password'
    )


  const emailLoginButton =
    document.getElementById(
      'email-login'
    )


  const showSignupButton =
    document.getElementById(
      'show-signup'
    )


  const showForgotButton =
    document.getElementById(
      'show-forgot'
    )


  const signupEmail =
    document.getElementById(
      'signup-email'
    )


  const signupPassword =
    document.getElementById(
      'signup-password'
    )


  const signupPasswordConfirm =
    document.getElementById(
      'signup-password-confirm'
    )


  const signupButton =
    document.getElementById(
      'signup-button'
    )


  const forgotEmail =
    document.getElementById(
      'forgot-email'
    )


  const forgotButton =
    document.getElementById(
      'forgot-button'
    )


  const backFromSignup =
    document.getElementById(
      'back-from-signup'
    )


  const backFromForgot =
    document.getElementById(
      'back-from-forgot'
    )


  const authMessage =
    document.getElementById(
      'auth-message'
    )


  /*
   * =========================
   * 共通
   * =========================
   */

  function setMessage(
    text = '',
    type = ''
  ) {

    if (!authMessage) {
      return
    }


    authMessage.textContent =
      text


    authMessage.classList.remove(
      'success',
      'error'
    )


    if (type) {

      authMessage.classList.add(
        type
      )
    }
  }


  function isValidEmail(
    email
  ) {

    return (
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/
        .test(email)
    )
  }


  function showPanel(
    panelName
  ) {

    loginPanel
      ?.classList
      .add('hidden')


    signupPanel
      ?.classList
      .add('hidden')


    forgotPanel
      ?.classList
      .add('hidden')


    if (
      panelName === 'login'
    ) {

      loginPanel
        ?.classList
        .remove('hidden')
    }


    if (
      panelName === 'signup'
    ) {

      signupPanel
        ?.classList
        .remove('hidden')
    }


    if (
      panelName === 'forgot'
    ) {

      forgotPanel
        ?.classList
        .remove('hidden')
    }


    setMessage('')
  }


  /*
   * =========================
   * すでにログイン済み
   * =========================
   */

  async function checkCurrentSession() {

    const {
      data: {
        session,
      },
    } =
      await supabase.auth
        .getSession()


    if (session) {

      window.location.href =
        '/'
    }
  }


  /*
   * =========================
   * Googleログイン
   * =========================
   */

  googleLoginButton
    ?.addEventListener(
      'click',
      async () => {

        setMessage(
          'Googleログインへ移動します…'
        )


        const {
          error,
        } =
          await supabase.auth
            .signInWithOAuth({
              provider:
                'google',

              options: {
                redirectTo:
                  window.location.origin,
              },
            })


        if (error) {

          console.error(
            'Google login error:',
            error
          )


          setMessage(
            'Googleログインを開始できませんでした。',
            'error'
          )
        }
      }
    )


  /*
   * =========================
   * メール＋パスワードログイン
   * =========================
   */

  async function loginWithEmail() {

    const email =
      loginEmail
        ?.value
        ?.trim() || ''


    const password =
      loginPassword
        ?.value || ''


    if (
      !email ||
      !password
    ) {

      setMessage(
        'メールアドレスとパスワードを入力してください。',
        'error'
      )

      return
    }


    if (
      !isValidEmail(email)
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      return
    }


    emailLoginButton.disabled =
      true


    emailLoginButton.textContent =
      'ログイン中…'


    try {

      const {
        error,
      } =
        await supabase.auth
          .signInWithPassword({
            email,
            password,
          })


      if (error) {

        console.error(
          'Email login error:',
          error
        )


        setMessage(
          'メールアドレスまたはパスワードを確認してください。メール認証がまだの場合は、確認メールもご確認ください。',
          'error'
        )

        return
      }


      window.location.href =
        '/'


    } catch (
      error
    ) {

      console.error(
        'Email login exception:',
        error
      )


      setMessage(
        'ログイン中にエラーが発生しました。',
        'error'
      )


    } finally {

      emailLoginButton.disabled =
        false


      emailLoginButton.textContent =
        'ログイン'
    }
  }


  /*
   * =========================
   * 新規登録
   * =========================
   */

  async function signUpWithEmail() {

    const email =
      signupEmail
        ?.value
        ?.trim() || ''


    const password =
      signupPassword
        ?.value || ''


    const passwordConfirm =
      signupPasswordConfirm
        ?.value || ''


    if (
      !email ||
      !password ||
      !passwordConfirm
    ) {

      setMessage(
        'すべての項目を入力してください。',
        'error'
      )

      return
    }


    if (
      !isValidEmail(email)
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      return
    }


    if (
      password.length < 6
    ) {

      setMessage(
        'パスワードは6文字以上で設定してください。',
        'error'
      )

      return
    }


    if (
      password !==
      passwordConfirm
    ) {

      setMessage(
        '確認用のパスワードが一致していません。',
        'error'
      )

      return
    }


    signupButton.disabled =
      true


    signupButton.textContent =
      '登録中…'


    try {

      const {
        data,
        error,
      } =
        await supabase.auth
          .signUp({
            email,
            password,

            options: {

              emailRedirectTo:
                `${window.location.origin}/`,
            },
          })


      if (error) {

        console.error(
          'Signup error:',
          error
        )


        setMessage(
          '新規登録できませんでした。入力内容をご確認ください。',
          'error'
        )

        return
      }


      /*
       * メール確認が無効の場合など、
       * すぐsessionが返るケース
       */
      if (
        data?.session
      ) {

        window.location.href =
          '/'

        return
      }


      setMessage(
        '登録確認メールを送りました🍸 メール内の「けいのBARへ入店する」を押して登録を完了してください。',
        'success'
      )


    } catch (
      error
    ) {

      console.error(
        'Signup exception:',
        error
      )


      setMessage(
        '新規登録中にエラーが発生しました。',
        'error'
      )


    } finally {

      signupButton.disabled =
        false


      signupButton.textContent =
        '新規登録'
    }
  }


  /*
   * =========================
   * パスワード再設定メール
   * =========================
   */

  async function sendPasswordReset() {

    const email =
      forgotEmail
        ?.value
        ?.trim() || ''


    if (!email) {

      setMessage(
        '登録したメールアドレスを入力してください。',
        'error'
      )

      return
    }


    if (
      !isValidEmail(email)
    ) {

      setMessage(
        'メールアドレスを確認してください。',
        'error'
      )

      return
    }


    forgotButton.disabled =
      true


    forgotButton.textContent =
      '送信中…'


    try {

      const {
        error,
      } =
        await supabase.auth
          .resetPasswordForEmail(
            email,
            {
              /*
               * メールのリンクを押したら
               * 新パスワード設定ページへ
               */
              redirectTo:
                `${window.location.origin}/reset-password`,
            }
          )


      if (error) {

        console.error(
          'Password reset error:',
          error
        )


        setMessage(
          '再設定メールを送信できませんでした。少し時間をおいてお試しください。',
          'error'
        )

        return
      }


      /*
       * アカウントの存在有無は
       * 表示上区別しない
       */
      setMessage(
        '該当するアカウントがある場合、パスワード再設定メールをお送りしました。',
        'success'
      )


    } catch (
      error
    ) {

      console.error(
        'Password reset exception:',
        error
      )


      setMessage(
        '再設定処理中にエラーが発生しました。',
        'error'
      )


    } finally {

      forgotButton.disabled =
        false


      forgotButton.textContent =
        '再設定メールを送る'
    }
  }


  /*
   * =========================
   * 画面切替
   * =========================
   */

  showSignupButton
    ?.addEventListener(
      'click',
      () => {

        showPanel(
          'signup'
        )
      }
    )


  showForgotButton
    ?.addEventListener(
      'click',
      () => {

        /*
         * ログイン欄のメールを
         * 入力済みなら引き継ぐ
         */
        const email =
          loginEmail
            ?.value
            ?.trim()


        if (
          email &&
          forgotEmail
        ) {

          forgotEmail.value =
            email
        }


        showPanel(
          'forgot'
        )
      }
    )


  backFromSignup
    ?.addEventListener(
      'click',
      () => {

        showPanel(
          'login'
        )
      }
    )


  backFromForgot
    ?.addEventListener(
      'click',
      () => {

        showPanel(
          'login'
        )
      }
    )


  /*
   * =========================
   * ボタン
   * =========================
   */

  emailLoginButton
    ?.addEventListener(
      'click',
      loginWithEmail
    )


  signupButton
    ?.addEventListener(
      'click',
      signUpWithEmail
    )


  forgotButton
    ?.addEventListener(
      'click',
      sendPasswordReset
    )


  /*
   * =========================
   * Enter送信
   * =========================
   */

  loginPassword
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key === 'Enter'
        ) {

          event.preventDefault()

          loginWithEmail()
        }
      }
    )


  signupPasswordConfirm
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key === 'Enter'
        ) {

          event.preventDefault()

          signUpWithEmail()
        }
      }
    )


  forgotEmail
    ?.addEventListener(
      'keydown',
      (
        event
      ) => {

        if (
          event.key === 'Enter'
        ) {

          event.preventDefault()

          sendPasswordReset()
        }
      }
    )


  /*
   * =========================
   * 起動
   * =========================
   */

  checkCurrentSession()
</script>


<style>

.login-page {

  min-height:
    100vh;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  padding:
    24px;
}


.login-card {

  width:
    min(
      440px,
      92vw
    );

  padding:
    34px;

  border-radius:
    18px;

  background:
    rgba(
      22,
      13,
      8,
      0.80
    );

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      0.16
    );

  backdrop-filter:
    blur(12px);

  text-align:
    center;

  box-shadow:
    0
    18px
    50px
    rgba(
      0,
      0,
      0,
      0.4
    );
}


.login-title {

  font-size:
    26px;

  font-weight:
    700;

  color:
    white;

  margin-bottom:
    10px;
}


.login-text {

  font-size:
    14px;

  color:
    rgba(
      255,
      255,
      255,
      0.72
    );

  margin-bottom:
    24px;
}


/* =========================
   Google
   ========================= */

.google-button {

  width:
    100%;

  height:
    54px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    12px;

  border:
    1px solid
    #dadce0;

  border-radius:
    10px;

  background:
    #fff;

  color:
    #202124;

  font-size:
    16px;

  font-weight:
    500;

  cursor:
    pointer;

  transition:
    transform .15s ease,
    box-shadow .15s ease;
}


.google-button:hover {

  transform:
    translateY(-1px);

  box-shadow:
    0
    6px
    18px
    rgba(
      0,
      0,
      0,
      .22
    );
}


.google-logo {

  width:
    22px;

  height:
    22px;

  flex-shrink:
    0;
}


/* =========================
   区切り
   ========================= */

.divider {

  display:
    flex;

  align-items:
    center;

  gap:
    12px;

  margin:
    24px 0;

  color:
    rgba(
      255,
      255,
      255,
      .40
    );

  font-size:
    12px;
}


.divider span {

  flex:
    1;

  height:
    1px;

  background:
    rgba(
      255,
      255,
      255,
      .14
    );
}


/* =========================
   各パネル
   ========================= */

.auth-panel {

  text-align:
    left;
}


.hidden {

  display:
    none;
}


.panel-title {

  margin-bottom:
    16px;

  color:
    #fff;

  font-size:
    18px;

  font-weight:
    700;

  text-align:
    center;
}


.panel-description {

  margin-bottom:
    18px;

  color:
    rgba(
      255,
      255,
      255,
      .60
    );

  font-size:
    13px;

  line-height:
    1.7;

  text-align:
    center;
}


/* =========================
   フォーム
   ========================= */

.field-label {

  display:
    block;

  margin-bottom:
    7px;

  color:
    rgba(
      255,
      255,
      255,
      .72
    );

  font-size:
    13px;
}


.password-label {

  margin-top:
    14px;
}


.field-input {

  width:
    100%;

  height:
    52px;

  box-sizing:
    border-box;

  padding:
    0 14px;

  border:
    1px solid
    rgba(
      255,
      255,
      255,
      .20
    );

  border-radius:
    10px;

  outline:
    none;

  background:
    rgba(
      255,
      255,
      255,
      .08
    );

  color:
    white;

  font-size:
    16px;
}


.field-input::placeholder {

  color:
    rgba(
      255,
      255,
      255,
      .30
    );
}


.field-input:focus {

  border-color:
    rgba(
      255,
      255,
      255,
      .48
    );

  background:
    rgba(
      255,
      255,
      255,
      .11
    );
}


/* =========================
   ボタン
   ========================= */

.primary-button {

  width:
    100%;

  height:
    52px;

  margin-top:
    18px;

  border:
    none;

  border-radius:
    10px;

  background:
    #f5eee9;

  color:
    #25120c;

  font-size:
    15px;

